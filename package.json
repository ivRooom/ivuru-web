{
  "name": "ivuru-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.3 || >=24.16.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:visual:capture": "node scripts/capture-visuals.mjs",
    "performance:check": "node scripts/check-performance-budget.mjs",
    "cloudflare:durable:check": "node scripts/check-cloudflare-durable-config.mjs",
    "deployment:routing:check": "node scripts/check-deployment-routing.mjs",
    "deploy": "wrangler deploy",
    "deploy:preview": "wrangler versions upload",
    "deploy:check": "npm run cloudflare:durable:check && npm run deployment:routing:check && npm run build && npm run performance:check && wrangler deploy --dry-run --outdir .wrangler/dry-run"
  },
  "dependencies": {
    "@astrojs/mdx": "7.0.3",
    "@astrojs/react": "6.0.1",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.3",
    "@react-three/drei": "10.7.7",
    "@react-three/fiber": "9.6.1",
    "@tailwindcss/vite": "4.3.2",
    "astro": "7.1.1",
    "framer-motion": "12.42.2",
    "gsap": "3.15.0",
    "lucide-react": "1.25.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tailwindcss": "4.3.2",
    "three": "0.185.1"
  },
  "overrides": {
    "fast-xml-parser": "5.10.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.185.1",
    "eslint": "10.7.0",
    "eslint-plugin-astro": "3.0.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.7.0",
    "prettier": "3.9.5",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "0.8.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0",
    "vitest": "4.1.10",
    "wrangler": "4.112.0"
  }
}
