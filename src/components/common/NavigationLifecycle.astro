<script>
  type PreparationEvent = Event & { navigationType?: 'push' | 'replace' | 'traverse' };

  const root = document.documentElement;
  const disabledLinkSelector = 'a[aria-disabled="true"], a[data-state="disabled"]';

  const setDocumentActivity = () => {
    root.dataset.documentActive = document.hidden ? 'false' : 'true';
  };

  const markExternalLinks = () => {
    document.querySelectorAll('a[target="_blank"]').forEach((node) => {
      if (!(node instanceof HTMLAnchorElement)) return;
      const alreadyCommunicated = /[↗→]/.test(node.textContent ?? '');
      if (node.dataset.uiExternal !== 'true') {
        node.dataset.uiExternal = alreadyCommunicated ? 'semantic' : 'true';
      }

      const rel = new Set((node.rel || '').split(/\s+/).filter(Boolean));
      rel.add('noopener');
      rel.add('noreferrer');
      node.rel = Array.from(rel).join(' ');
    });
  };

  const syncDisabledLinks = () => {
    document.querySelectorAll(disabledLinkSelector).forEach((node) => {
      if (!(node instanceof HTMLAnchorElement)) return;
      if (!node.hasAttribute('data-disabled-tabindex')) {
        node.dataset.disabledTabindex = node.getAttribute('tabindex') ?? '';
      }
      node.setAttribute('tabindex', '-1');
    });

    document.querySelectorAll('a[data-disabled-tabindex]').forEach((node) => {
      if (!(node instanceof HTMLAnchorElement) || node.matches(disabledLinkSelector)) return;
      const previousTabindex = node.dataset.disabledTabindex;
      if (previousTabindex) node.setAttribute('tabindex', previousTabindex);
      else node.removeAttribute('tabindex');
      delete node.dataset.disabledTabindex;
    });
  };

  const focusRouteTarget = () => {
    if (location.hash) {
      try {
        const id = decodeURIComponent(location.hash.slice(1));
        const target = document.getElementById(id);
        if (target) {
          if (!target.hasAttribute('tabindex')) target.setAttribute('tabindex', '-1');
          target.focus({ preventScroll: false });
          return;
        }
      } catch {
        // Invalid URL fragments fall back to the page title.
      }
    }

    const title = document.querySelector('#main-content h1');
    if (!(title instanceof HTMLElement)) return;
    if (!title.hasAttribute('tabindex')) title.setAttribute('tabindex', '-1');
    title.focus({ preventScroll: true });
  };

  if (root.dataset.ivuruNavigationBound !== 'true') {
    root.dataset.ivuruNavigationBound = 'true';
    let shouldFocusAfterNavigation = false;
    let completionFrame = 0;

    const setRouteState = (state: 'idle' | 'loading' | 'prepared' | 'complete') => {
      const body = document.body;
      if (!body) return;
      body.dataset.routeState = state;
      if (state === 'loading' || state === 'prepared') body.setAttribute('aria-busy', 'true');
      else body.removeAttribute('aria-busy');
    };

    document.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const disabledLink = target.closest(disabledLinkSelector);
      if (!(disabledLink instanceof HTMLAnchorElement)) return;
      event.preventDefault();
      event.stopPropagation();
    });

    document.addEventListener('astro:before-preparation', (event) => {
      const navigationEvent = event as PreparationEvent;
      shouldFocusAfterNavigation = navigationEvent.navigationType !== 'traverse';
      cancelAnimationFrame(completionFrame);
      setRouteState('loading');
      document.dispatchEvent(new CustomEvent('ivuru:route-start'));
    });

    document.addEventListener('astro:after-preparation', () => {
      setRouteState('prepared');
    });

    document.addEventListener('astro:after-swap', () => {
      setRouteState('prepared');
      setDocumentActivity();
      markExternalLinks();
      syncDisabledLinks();
    });

    document.addEventListener('astro:page-load', () => {
      setRouteState('complete');
      setDocumentActivity();
      markExternalLinks();
      syncDisabledLinks();

      if (shouldFocusAfterNavigation) {
        shouldFocusAfterNavigation = false;
        requestAnimationFrame(focusRouteTarget);
      }

      completionFrame = requestAnimationFrame(() => {
        requestAnimationFrame(() => setRouteState('idle'));
      });
    });

    document.addEventListener('visibilitychange', setDocumentActivity, { passive: true });
  }

  setDocumentActivity();
  markExternalLinks();
  syncDisabledLinks();
</script>
