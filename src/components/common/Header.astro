---
import Logo from './Logo.astro';
import ThemeSwitcher from './ThemeSwitcher';
import LanguageSwitcher from './LanguageSwitcher';
import MobileMenu from './MobileMenu';
import { navigation } from '@/data/navigation';
import { siteConfig, type Locale } from '@/data/site-config';
import { getDictionary } from '@/i18n/dictionaries';

const { locale = 'ja' } = Astro.props as { locale: Locale };
const dict = getDictionary(locale);
const normalizePath = (path: string) => path.replace(/\/$/, '') || '/';
const currentPath = normalizePath(Astro.url.pathname);
const items = navigation(locale).map((item) => {
  const target = normalizePath(item.href);
  const active = target === '/' ? currentPath === '/' : currentPath === target || currentPath.startsWith(`${target}/`);
  return {
    ...item,
    active,
    label: dict.nav[item.key as keyof typeof dict.nav],
  };
});
---

<header class="site-header" data-site-header>
  <a class="logo-link" href={items[0].href} aria-label="いゔる。 / ivuru Home"><Logo /></a>
  <nav class="desktop-nav" aria-label="Primary navigation">
    {
      items.map((item) => (
        <a class:list={{ active: item.active }} href={item.href} aria-current={item.active ? 'page' : undefined}>
          {item.label}
        </a>
      ))
    }
  </nav>
  <div class="header-actions">
    <a
      class="x-link"
      href={siteConfig.xUrl}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`${siteConfig.name} on X`}>X</a
    >
    <LanguageSwitcher client:load current={locale} />
    <ThemeSwitcher client:load />
    <MobileMenu
      client:load
      items={items}
      xUrl={siteConfig.xUrl}
      xHandle={siteConfig.xHandle}
      displayName={siteConfig.name}
      idName={siteConfig.idName}
    />
  </div>
</header>
<script>
  const updateCurrentHeader = () => {
    const header = document.querySelector<HTMLElement>('[data-site-header]');
    if (!header) return;
    const now = window.scrollY;
    const menuOpen = document.body.classList.contains('menu-open');
    header.classList.toggle('scrolled', now > 24 || menuOpen);
    if (menuOpen) header.classList.remove('hidden');
  };

  updateCurrentHeader();

  const root = document.documentElement;
  if (root.dataset.ivuruHeaderBound !== 'true') {
    root.dataset.ivuruHeaderBound = 'true';
    let last = window.scrollY;
    let ticking = false;

    const updateHeader = () => {
      const header = document.querySelector<HTMLElement>('[data-site-header]');
      if (!header) {
        ticking = false;
        return;
      }
      const now = window.scrollY;
      const menuOpen = document.body.classList.contains('menu-open');
      header.classList.toggle('scrolled', now > 24 || menuOpen);
      header.classList.toggle('hidden', !menuOpen && now > last && now > 160);
      if (menuOpen) header.classList.remove('hidden');
      last = now;
      ticking = false;
    };

    const queueUpdate = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(updateHeader);
    };

    document.addEventListener('scroll', queueUpdate, { passive: true });
    document.addEventListener('astro:page-load', () => {
      last = window.scrollY;
      queueUpdate();
    });
    document.addEventListener('ivuru:menu-state', queueUpdate);
  }
</script>