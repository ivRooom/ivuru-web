---
import Logo from './Logo.astro';
import ThemeSwitcher from './ThemeSwitcher';
import LanguageSwitcher from './LanguageSwitcher';
import MobileMenu from './MobileMenu';
import { navigation } from '@/data/navigation';
import { siteConfig, type Locale } from '@/data/site-config';
import { getDictionary } from '@/i18n/dictionaries';

type Chapter = {
  code: string;
  title: string;
  world: string;
};

const { locale = 'ja', chapter = { code: '00', title: 'WORLD GATE', world: 'NEXUS' } } =
  Astro.props as { locale: Locale; chapter?: Chapter };
const dict = getDictionary(locale);
const normalizePath = (path: string) => path.replace(/\/$/, '') || '/';
const currentPath = normalizePath(Astro.url.pathname);
const items = navigation(locale).map((item) => {
  const target = normalizePath(item.href);
  const active =
    target === '/'
      ? currentPath === '/'
      : currentPath === target || currentPath.startsWith(`${target}/`);
  return {
    ...item,
    active,
    label: dict.nav[item.key as keyof typeof dict.nav],
  };
});
---

<header
  class="site-header"
  data-site-header
  data-current-chapter={chapter.code}
  transition:name="site-header"
>
  <a
    class="logo-link"
    href={items[0].href}
    aria-label="いゔる。 / ivuru Home"
    data-ui-action
  >
    <Logo />
  </a>
  <div class="header-location" aria-label={`Current location: ${chapter.code} ${chapter.title}`}>
    <span>{chapter.code}</span>
    <strong>{chapter.title}</strong>
  </div>
  <nav class="desktop-nav" aria-label="Primary navigation">
    {
      items.map((item) => (
        <a
          class:list={{ active: item.active }}
          href={item.href}
          aria-current={item.active ? 'page' : undefined}
          data-ui-action
        >
          {item.label}
        </a>
      ))
    }
  </nav>
  <div class="header-actions">
    <a
      class="x-link"
      href={siteConfig.xUrl}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`${siteConfig.name} on X`}
      data-ui-action
      data-ui-external="true">X</a
    >
    <LanguageSwitcher client:load current={locale} />
    <ThemeSwitcher client:load />
    <MobileMenu
      client:load
      items={items}
      xUrl={siteConfig.xUrl}
      xHandle={siteConfig.xHandle}
      displayName={siteConfig.name}
      idName={siteConfig.idName}
      locale={locale}
    />
  </div>
</header>
<script>
  let headerObserver: IntersectionObserver | undefined;
  let sentinelVisible = true;

  const updateCurrentHeader = () => {
    const header = document.querySelector<HTMLElement>('[data-site-header]');
    if (!header) return;
    const menuOpen = document.body.classList.contains('menu-open');
    header.classList.toggle('scrolled', !sentinelVisible || menuOpen);
    header.classList.remove('hidden');
  };

  const observeHeaderSentinel = () => {
    headerObserver?.disconnect();
    headerObserver = undefined;
    sentinelVisible = true;

    const sentinel = document.querySelector<HTMLElement>('[data-header-sentinel]');
    if (!sentinel || !('IntersectionObserver' in window)) {
      updateCurrentHeader();
      return;
    }

    headerObserver = new IntersectionObserver(
      ([entry]) => {
        sentinelVisible = entry?.isIntersecting ?? true;
        updateCurrentHeader();
      },
      {
        root: null,
        rootMargin: '0px',
        threshold: [0, 1],
      },
    );
    headerObserver.observe(sentinel);
    updateCurrentHeader();
  };

  const root = document.documentElement;
  if (root.dataset.ivuruHeaderBound !== 'true') {
    root.dataset.ivuruHeaderBound = 'true';
    document.addEventListener('astro:page-load', observeHeaderSentinel);
    document.addEventListener('ivuru:menu-state', updateCurrentHeader);
  }

  observeHeaderSentinel();
</script>
