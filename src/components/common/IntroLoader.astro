---
type Locale = 'ja' | 'en' | 'ko';

const { locale = 'ja' } = Astro.props as { locale?: Locale };
const copy = {
  ja: {
    label: 'いゔる。を読み込んでいます',
    status: 'ページを読み込んでいます。',
    orbit: '軌道を同期しています',
    drive: 'ドライブシステムを起動しています',
    tagline: 'BUILD. PLAY. CONNECT.',
  },
  en: {
    label: 'Loading ivuru',
    status: 'Loading the page.',
    orbit: 'Synchronizing orbital phase',
    drive: 'Booting drive system',
    tagline: 'BUILD. PLAY. CONNECT.',
  },
  ko: {
    label: 'ivuru를 불러오는 중입니다',
    status: '페이지를 불러오는 중입니다.',
    orbit: '궤도 위상을 동기화하는 중',
    drive: '드라이브 시스템을 시작하는 중',
    tagline: 'BUILD. PLAY. CONNECT.',
  },
}[locale];
---

<noscript>
  <style>
    .anime-intro-loader {
      display: none !important;
    }
  </style>
</noscript>

<script is:inline>
  (() => {
    const root = document.documentElement;
    try {
      const previous = sessionStorage.getItem('ivuru-loader-theme');
      const initial = globalThis.crypto?.getRandomValues
        ? globalThis.crypto.getRandomValues(new Uint8Array(1))[0] % 2 === 0
          ? 'orbit'
          : 'drive'
        : Date.now() % 2 === 0
          ? 'orbit'
          : 'drive';
      const next = previous === 'orbit' ? 'drive' : previous === 'drive' ? 'orbit' : initial;
      sessionStorage.setItem('ivuru-loader-theme', next);
      root.dataset.loaderTheme = next;
    } catch {
      root.dataset.loaderTheme = 'orbit';
    }
  })();
</script>

<div
  class="intro-loader world-loader anime-intro-loader dual-loader"
  data-dual-loader
  data-orbit-status={copy.orbit}
  data-drive-status={copy.drive}
  style="--loader-progress: 0%;"
>
  <span class="sr-only" role="status" aria-live="polite" aria-atomic="true">
    {copy.status}
  </span>

  <div class="dual-loader__ambient" aria-hidden="true">
    <span></span><span></span><span></span>
  </div>

  <div class="dual-loader__frame">
    <header class="dual-loader__topline" aria-hidden="true">
      <span>IVURU / INITIALIZATION</span>
      <span data-loader-theme-label>ORBIT &amp; PHASE</span>
    </header>

    <div class="dual-loader__stage" aria-hidden="true">
      <div class="loader-theme loader-theme--orbit">
        <div class="orbit-system">
          <span class="orbit-ring orbit-ring--outer"><i></i></span>
          <span class="orbit-ring orbit-ring--middle"><i></i></span>
          <span class="orbit-ring orbit-ring--inner"><i></i></span>
          <span class="orbit-axis orbit-axis--x"></span>
          <span class="orbit-axis orbit-axis--y"></span>
          <span class="orbit-sphere"><i></i></span>
          <span class="orbit-coordinate">X:128.4 / Y:064.2 / Z:512.0</span>
        </div>
      </div>

      <div class="loader-theme loader-theme--drive">
        <div class="drive-scene">
          <div class="drive-grid drive-grid--far"></div>
          <div class="drive-grid drive-grid--near"></div>
          <div class="low-poly-car">
            <span class="car-shadow"></span>
            <span class="car-body"><i></i></span>
            <span class="car-cabin"></span>
            <span class="car-light car-light--left"></span>
            <span class="car-light car-light--right"></span>
            <span class="car-wheel car-wheel--front"><i></i></span>
            <span class="car-wheel car-wheel--back"><i></i></span>
          </div>
          <span class="drive-horizon"></span>
          <span class="drive-coordinate">VELOCITY: 096 / VECTOR: FORWARD</span>
        </div>
      </div>
    </div>

    <div class="dual-loader__copy">
      <p data-loader-status>{copy.orbit}</p>
      <strong>いゔる。</strong>
      <span>{copy.tagline}</span>
    </div>

    <footer class="dual-loader__footer">
      <div class="dual-loader__metadata" aria-hidden="true">
        <span>SYSTEM.STATUS: <b data-loader-system-state>LOADING</b></span>
        <span>FPS: 60 TARGET</span>
        <span>RENDER: CSS_3D</span>
      </div>
      <div
        class="dual-loader__progress"
        role="progressbar"
        aria-label={copy.label}
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="0"
      >
        <span><i></i></span>
        <b data-loader-progress-text>000</b>
      </div>
    </footer>
  </div>
</div>

<script is:inline>
  (() => {
    const loader = document.querySelector('[data-dual-loader]');
    if (!(loader instanceof HTMLElement) || loader.dataset.bound === 'true') return;
    loader.dataset.bound = 'true';

    const root = document.documentElement;
    const progressbar = loader.querySelector('[role="progressbar"]');
    const progressText = loader.querySelector('[data-loader-progress-text]');
    const statusText = loader.querySelector('[data-loader-status]');
    const themeLabel = loader.querySelector('[data-loader-theme-label]');
    const systemState = loader.querySelector('[data-loader-system-state]');
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const theme = root.dataset.loaderTheme === 'drive' ? 'drive' : 'orbit';
    const themeStatus = theme === 'drive' ? loader.dataset.driveStatus : loader.dataset.orbitStatus;

    loader.dataset.theme = theme;
    if (statusText) statusText.textContent = themeStatus ?? '';
    if (themeLabel) themeLabel.textContent = theme === 'drive' ? 'LOW-POLY DRIVE' : 'ORBIT & PHASE';

    let seen = true;
    try {
      seen = sessionStorage.getItem('ivuru-intro-seen') === '1';
      sessionStorage.setItem('ivuru-intro-seen', '1');
    } catch {
      seen = true;
    }

    const duration = reduced ? 80 : seen ? 420 : 1120;
    const exitDuration = reduced ? 20 : 460;
    const startedAt = performance.now();
    let readyAt = document.readyState === 'complete' ? startedAt : null;
    let frame = 0;
    let released = false;

    const renderProgress = (value) => {
      const next = Math.max(0, Math.min(100, Math.round(value)));
      loader.style.setProperty('--loader-progress', `${next}%`);
      progressbar?.setAttribute('aria-valuenow', String(next));
      if (progressText) progressText.textContent = String(next).padStart(3, '0');
    };

    const release = () => {
      if (released) return;
      released = true;
      renderProgress(100);
      loader.classList.add('loaded');
      loader.dataset.state = 'ready';
      if (systemState) systemState.textContent = 'READY';
      root.dataset.loaderReleased = 'true';
      window.setTimeout(() => {
        document.body.classList.remove('site-loading');
        loader.setAttribute('aria-hidden', 'true');
        document.dispatchEvent(new CustomEvent('ivuru:loader-released', { detail: { theme } }));
      }, exitDuration);
    };

    const tick = (now) => {
      const elapsed = now - startedAt;
      const base = Math.min(88, (elapsed / Math.max(duration, 1)) * 88);
      const readyRatio =
        readyAt === null ? 0 : Math.min(1, (now - readyAt) / Math.max(duration * 0.2, 1));
      renderProgress(base + (100 - base) * readyRatio);

      if ((readyAt !== null && elapsed >= duration) || elapsed >= duration + 500) {
        release();
        return;
      }
      frame = requestAnimationFrame(tick);
    };

    const markReady = () => {
      readyAt ??= performance.now();
    };

    document.body.classList.add('site-loading');
    loader.dataset.state = 'loading';
    renderProgress(reduced ? 100 : 0);
    if (readyAt === null) window.addEventListener('load', markReady, { once: true });
    frame = requestAnimationFrame(tick);

    window.addEventListener(
      'pagehide',
      () => {
        cancelAnimationFrame(frame);
        window.removeEventListener('load', markReady);
        document.body.classList.remove('site-loading');
      },
      { once: true },
    );
  })();
</script>

<style>
  :global(.world-loader.anime-intro-loader.dual-loader) {
    --loader-bg: #0a0a0c;
    --loader-panel: #111116;
    --loader-white: #f8fbff;
    --loader-muted: rgb(225 234 245 / 52%);
    --loader-blue: #38bdf8;
    --loader-blue-soft: #a7ecff;
    --loader-gold: #f6d47a;
    --loader-line: rgb(180 220 255 / 12%);
    --loader-ease: cubic-bezier(0.16, 1, 0.3, 1);
    --loader-spring: cubic-bezier(0.22, 1.24, 0.36, 1);

    position: fixed;
    z-index: 6000;
    inset: 0;
    display: grid;
    place-items: center;
    box-sizing: border-box;
    overflow: hidden;
    padding: clamp(20px, 4vw, 52px);
    color: var(--loader-white);
    background:
      radial-gradient(circle at 50% 42%, rgb(56 189 248 / 8%), transparent 31%),
      linear-gradient(145deg, #0a0a0c, #0d1016 52%, #08090c);
    opacity: 1;
    visibility: visible;
    clip-path: none;
    transform: translateZ(0) scale(1);
    transition:
      opacity 420ms var(--loader-ease),
      visibility 420ms var(--loader-ease),
      transform 520ms var(--loader-ease);
    isolation: isolate;
  }

  :global(.world-loader.anime-intro-loader.dual-loader::before) {
    position: absolute;
    inset: 0;
    content: '';
    pointer-events: none;
    background-image:
      linear-gradient(rgb(255 255 255 / 2.5%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 2.5%) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(circle at center, #000 0 28%, transparent 78%);
    opacity: 0.42;
  }

  :global(.world-loader.anime-intro-loader.dual-loader::after) {
    position: absolute;
    inset: 0;
    content: '';
    pointer-events: none;
    background: radial-gradient(circle at 50% 50%, transparent 45%, rgb(0 0 0 / 42%) 100%);
  }

  :global(.dual-loader.loaded),
  :global(.dual-loader[data-failsafe-hidden='true']) {
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transform: translateZ(0) scale(1.015);
  }

  .dual-loader__ambient {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .dual-loader__ambient span {
    position: absolute;
    width: 5px;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--loader-blue-soft);
    box-shadow: 0 0 20px rgb(56 189 248 / 52%);
    animation: loader-particle 4.6s var(--loader-ease) infinite;
  }

  .dual-loader__ambient span:nth-child(1) {
    top: 18%;
    left: 16%;
  }

  .dual-loader__ambient span:nth-child(2) {
    top: 27%;
    right: 18%;
    animation-delay: -1.8s;
  }

  .dual-loader__ambient span:nth-child(3) {
    right: 24%;
    bottom: 16%;
    animation-delay: -3.1s;
  }

  .dual-loader__frame {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-rows: auto minmax(220px, 1fr) auto auto;
    width: min(1040px, 100%);
    min-height: min(680px, calc(100svh - 48px));
    padding: clamp(20px, 3vw, 34px);
    border: 1px solid var(--loader-line);
    border-radius: clamp(24px, 4vw, 42px);
    background: linear-gradient(145deg, rgb(255 255 255 / 3.5%), rgb(255 255 255 / 1%));
    box-shadow:
      inset 0 1px rgb(255 255 255 / 6%),
      0 40px 120px rgb(0 0 0 / 34%);
  }

  .dual-loader__topline,
  .dual-loader__metadata {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    color: var(--loader-muted);
    font:
      650 0.6rem/1.4 ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .dual-loader__stage {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 320px;
    perspective: 1100px;
    transform-style: preserve-3d;
  }

  .loader-theme {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    opacity: 0;
    visibility: hidden;
    transform: translate3d(0, 12px, 0) scale(0.98);
    transition:
      opacity 320ms var(--loader-ease),
      transform 520ms var(--loader-spring),
      visibility 320ms;
  }

  :global(html[data-loader-theme='orbit']) .loader-theme--orbit,
  :global(html[data-loader-theme='drive']) .loader-theme--drive {
    opacity: 1;
    visibility: visible;
    transform: translate3d(0, 0, 0) scale(1);
  }

  .orbit-system {
    position: relative;
    width: clamp(220px, 32vw, 360px);
    aspect-ratio: 1;
    transform-style: preserve-3d;
    animation: orbit-system-breathe 3.2s var(--loader-ease) infinite;
  }

  .orbit-ring {
    position: absolute;
    inset: 8%;
    border: 1px solid rgb(167 236 255 / 42%);
    border-radius: 50%;
    box-shadow: 0 0 28px rgb(56 189 248 / 8%);
    transform-style: preserve-3d;
  }

  .orbit-ring i {
    position: absolute;
    top: 50%;
    left: -5px;
    width: 9px;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--loader-white);
    box-shadow: 0 0 18px rgb(167 236 255 / 64%);
    transform: translateY(-50%);
  }

  .orbit-ring--outer {
    animation: orbit-outer 5.4s linear infinite;
  }

  .orbit-ring--middle {
    inset: 18%;
    border-color: rgb(246 212 122 / 38%);
    animation: orbit-middle 4.2s linear infinite reverse;
  }

  .orbit-ring--middle i {
    background: var(--loader-gold);
    box-shadow: 0 0 18px rgb(246 212 122 / 52%);
  }

  .orbit-ring--inner {
    inset: 28%;
    border-style: dashed;
    border-color: rgb(255 255 255 / 24%);
    animation: orbit-inner 3.4s linear infinite;
  }

  .orbit-axis {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 76%;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgb(167 236 255 / 35%), transparent);
    transform-origin: center;
  }

  .orbit-axis--x {
    transform: translate(-50%, -50%) rotate(28deg);
  }

  .orbit-axis--y {
    transform: translate(-50%, -50%) rotate(118deg);
  }

  .orbit-sphere {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 34%;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 50%;
    background: radial-gradient(
      circle at 32% 27%,
      #fff 0 4%,
      #c9f3ff 13%,
      #5dcff7 34%,
      #12648d 66%,
      #06121d 100%
    );
    box-shadow:
      inset -22px -18px 38px rgb(0 0 0 / 48%),
      0 0 46px rgb(56 189 248 / 24%);
    transform: translate3d(-50%, -50%, 56px);
  }

  .orbit-sphere i {
    position: absolute;
    inset: -8%;
    border-radius: 50%;
    background: #071019;
    opacity: 0.78;
    transform: translate3d(62%, 0, 2px);
    animation: orbit-phase 2.8s var(--loader-ease) infinite alternate;
  }

  .orbit-coordinate,
  .drive-coordinate {
    position: absolute;
    right: 0;
    bottom: -32px;
    left: 0;
    color: rgb(225 234 245 / 35%);
    font:
      600 0.54rem/1 ui-monospace,
      SFMono-Regular,
      Menlo,
      monospace;
    letter-spacing: 0.14em;
    text-align: center;
  }

  .drive-scene {
    position: relative;
    width: clamp(280px, 44vw, 520px);
    height: clamp(210px, 28vw, 320px);
    transform-style: preserve-3d;
  }

  .drive-grid {
    position: absolute;
    top: 44%;
    left: 50%;
    width: 170%;
    height: 130%;
    background-image:
      linear-gradient(rgb(56 189 248 / 24%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(56 189 248 / 24%) 1px, transparent 1px);
    background-size: 42px 42px;
    mask-image: linear-gradient(to top, #000, transparent 88%);
    transform-origin: top center;
    transform: translate3d(-50%, 0, -80px) rotateX(68deg);
  }

  .drive-grid--far {
    opacity: 0.28;
    animation: drive-grid-flow 1.1s linear infinite;
  }

  .drive-grid--near {
    opacity: 0.42;
    transform: translate3d(-50%, 18px, -40px) rotateX(68deg);
    animation: drive-grid-flow 0.72s linear infinite;
  }

  .drive-horizon {
    position: absolute;
    top: 44%;
    right: 2%;
    left: 2%;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--loader-blue), transparent);
    box-shadow: 0 0 24px rgb(56 189 248 / 35%);
  }

  .low-poly-car {
    position: absolute;
    z-index: 4;
    top: 42%;
    left: 50%;
    width: 190px;
    height: 92px;
    transform-style: preserve-3d;
    animation: car-spring 0.84s var(--loader-spring) infinite;
  }

  .car-body {
    position: absolute;
    top: 28px;
    left: 8px;
    width: 174px;
    height: 48px;
    clip-path: polygon(8% 28%, 22% 4%, 76% 0, 96% 28%, 100% 74%, 86% 100%, 10% 94%, 0 66%);
    background: linear-gradient(145deg, #f8fbff 0 18%, #7bdcff 38%, #1678aa 78%, #072d43 100%);
    box-shadow: 0 18px 38px rgb(0 0 0 / 34%);
    transform: translateZ(20px);
  }

  .car-body i {
    position: absolute;
    top: 10px;
    right: 20px;
    left: 24px;
    height: 2px;
    background: linear-gradient(90deg, transparent, rgb(255 255 255 / 72%), transparent);
  }

  .car-cabin {
    position: absolute;
    top: 8px;
    left: 58px;
    width: 82px;
    height: 42px;
    clip-path: polygon(18% 0, 76% 0, 100% 100%, 0 100%);
    background: linear-gradient(145deg, #b7efff, #175c81 58%, #081c2a);
    border: 1px solid rgb(255 255 255 / 34%);
    transform: translateZ(28px) rotateX(-3deg);
  }

  .car-wheel {
    position: absolute;
    top: 60px;
    width: 34px;
    aspect-ratio: 1;
    border: 6px solid #050608;
    border-radius: 50%;
    background: #1b2028;
    box-shadow: 0 0 0 2px rgb(255 255 255 / 12%);
    transform: translateZ(32px);
  }

  .car-wheel i {
    position: absolute;
    inset: 7px;
    border: 2px dashed rgb(167 236 255 / 56%);
    border-radius: 50%;
    animation: wheel-spin 0.58s linear infinite;
  }

  .car-wheel--front {
    right: 24px;
  }

  .car-wheel--back {
    left: 24px;
  }

  .car-light {
    position: absolute;
    z-index: 3;
    top: 43px;
    width: 9px;
    height: 7px;
    border-radius: 50%;
    background: var(--loader-gold);
    box-shadow: 0 0 16px rgb(246 212 122 / 62%);
    transform: translateZ(34px);
  }

  .car-light--left {
    left: 15px;
  }

  .car-light--right {
    right: 15px;
  }

  .car-shadow {
    position: absolute;
    top: 82px;
    left: 24px;
    width: 150px;
    height: 18px;
    border-radius: 50%;
    background: rgb(0 0 0 / 38%);
    transform: translateZ(-6px) scaleX(1);
    animation: car-shadow 0.84s var(--loader-spring) infinite;
  }

  .dual-loader__copy {
    display: grid;
    justify-items: center;
    margin-top: -12px;
    text-align: center;
  }

  .dual-loader__copy p,
  .dual-loader__copy span {
    margin: 0;
    color: var(--loader-muted);
    font:
      650 0.62rem/1.5 ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;
    letter-spacing: 0.17em;
    text-transform: uppercase;
  }

  .dual-loader__copy strong {
    margin: 10px 0 8px;
    color: var(--loader-white);
    font-size: clamp(2.7rem, 7vw, 5.4rem);
    font-weight: 780;
    line-height: 0.9;
    letter-spacing: -0.11em;
    text-shadow: 0 18px 50px rgb(56 189 248 / 18%);
  }

  .dual-loader__footer {
    display: grid;
    grid-template-columns: 1fr minmax(240px, 36%);
    gap: clamp(18px, 3vw, 42px);
    align-items: end;
    margin-top: clamp(22px, 3vw, 38px);
    padding-top: 18px;
    border-top: 1px solid var(--loader-line);
  }

  .dual-loader__metadata {
    justify-content: flex-start;
    flex-wrap: wrap;
    gap: 10px 24px;
  }

  .dual-loader__metadata b {
    color: var(--loader-blue-soft);
    font-weight: inherit;
  }

  .dual-loader__progress {
    display: grid;
    grid-template-columns: 1fr 3ch;
    gap: 12px;
    align-items: center;
  }

  .dual-loader__progress > span {
    position: relative;
    height: 2px;
    overflow: hidden;
    background: rgb(255 255 255 / 10%);
  }

  .dual-loader__progress i {
    position: absolute;
    inset: 0 auto 0 0;
    width: var(--loader-progress);
    background: linear-gradient(90deg, var(--loader-blue), var(--loader-blue-soft));
    box-shadow: 0 0 16px rgb(56 189 248 / 42%);
    transition: width 90ms linear;
  }

  :global(html[data-loader-theme='drive']) .dual-loader__progress i {
    background: linear-gradient(90deg, var(--loader-gold), var(--loader-blue));
  }

  .dual-loader__progress b {
    color: var(--loader-white);
    font:
      650 0.68rem/1 ui-monospace,
      SFMono-Regular,
      Menlo,
      monospace;
    letter-spacing: 0.08em;
  }

  @keyframes orbit-outer {
    from {
      transform: rotateX(68deg) rotateZ(0deg);
    }
    to {
      transform: rotateX(68deg) rotateZ(360deg);
    }
  }

  @keyframes orbit-middle {
    from {
      transform: rotateY(64deg) rotateZ(0deg);
    }
    to {
      transform: rotateY(64deg) rotateZ(360deg);
    }
  }

  @keyframes orbit-inner {
    from {
      transform: rotateX(34deg) rotateY(54deg) rotateZ(0deg);
    }
    to {
      transform: rotateX(34deg) rotateY(54deg) rotateZ(360deg);
    }
  }

  @keyframes orbit-phase {
    from {
      transform: translate3d(72%, -2%, 2px) scale(1.05);
    }
    to {
      transform: translate3d(20%, 2%, 2px) scale(1.02);
    }
  }

  @keyframes orbit-system-breathe {
    0%,
    100% {
      transform: translate3d(0, 2px, 0) scale(0.995);
    }
    50% {
      transform: translate3d(0, -5px, 0) scale(1.01);
    }
  }

  @keyframes drive-grid-flow {
    from {
      translate: 0 -42px;
    }
    to {
      translate: 0 42px;
    }
  }

  @keyframes car-spring {
    0%,
    100% {
      transform: translate3d(-50%, -50%, 44px) scale3d(1.02, 0.98, 1);
    }
    42% {
      transform: translate3d(-50%, -58%, 54px) scale3d(0.98, 1.035, 1);
    }
    68% {
      transform: translate3d(-50%, -49%, 45px) scale3d(1.01, 0.99, 1);
    }
