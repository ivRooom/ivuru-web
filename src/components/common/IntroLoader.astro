---
type Locale = 'ja' | 'en' | 'ko';

const { locale = 'ja' } = Astro.props as { locale?: Locale };
const copy = {
  ja: {
    label: 'いゔる。を読み込んでいます',
    status: 'ページを読み込んでいます。',
    phase: '世界を同期しています',
    tagline: 'BUILD. PLAY. CONNECT.',
  },
  en: {
    label: 'Loading ivuru',
    status: 'Loading the page.',
    phase: 'Synchronizing worlds',
    tagline: 'BUILD. PLAY. CONNECT.',
  },
  ko: {
    label: 'ivuru를 불러오는 중입니다',
    status: '페이지를 불러오는 중입니다.',
    phase: '세계를 동기화하는 중',
    tagline: 'BUILD. PLAY. CONNECT.',
  },
}[locale];
---

<noscript>
  <style>
    .anime-intro-loader {
      display: none !important;
    }
  </style>
</noscript>

<div
  class="intro-loader world-loader anime-intro-loader orbital-loader"
  data-orbital-loader
  style="--loader-progress: 0%;"
>
  <span class="sr-only" role="status" aria-live="polite" aria-atomic="true">
    {copy.status}
  </span>

  <div class="orbital-loader__chrome" aria-hidden="true">
    <span>IVURU / ORBITAL CORE</span>
    <span>CSS 3D · NODE 00</span>
  </div>

  <div class="orbital-loader__stage" aria-hidden="true">
    <div class="orbital-system">
      <span class="orbital-bloom"></span>
      <span class="orbital-axis orbital-axis--x"></span>
      <span class="orbital-axis orbital-axis--y"></span>
      <span class="orbital-ring orbital-ring--outer"><i></i></span>
      <span class="orbital-ring orbital-ring--middle"><i></i></span>
      <span class="orbital-ring orbital-ring--inner"><i></i></span>
      <span class="orbital-core"><i></i><b></b></span>
      <span class="orbital-point orbital-point--a"></span>
      <span class="orbital-point orbital-point--b"></span>
    </div>
  </div>

  <div class="orbital-loader__copy">
    <p>{copy.phase}</p>
    <strong>いゔる。</strong>
    <span>{copy.tagline}</span>
  </div>

  <div class="orbital-loader__footer">
    <div class="orbital-loader__metadata" aria-hidden="true">
      <span>SYSTEM.STATUS: <b data-loader-state>LOADING</b></span>
      <span>RENDER: TRANSFORM / OPACITY</span>
    </div>

    <div
      class="orbital-loader__progress"
      role="progressbar"
      aria-label={copy.label}
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="0"
    >
      <span><i></i></span>
      <b data-loader-progress>000</b>
    </div>
  </div>
</div>

<script is:inline>
  (() => {
    const loader = document.querySelector('[data-orbital-loader]');
    if (!(loader instanceof HTMLElement) || loader.dataset.bound === 'true') return;
    loader.dataset.bound = 'true';

    const root = document.documentElement;
    const progressbar = loader.querySelector('[role="progressbar"]');
    const progressText = loader.querySelector('[data-loader-progress]');
    const stateText = loader.querySelector('[data-loader-state]');
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (root.dataset.loaderReleased === 'true') {
      loader.classList.add('loaded');
      loader.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('site-loading');
      return;
    }

    const seen = (() => {
      try {
        const hasSeen = sessionStorage.getItem('ivuru-intro-seen') === '1';
        sessionStorage.setItem('ivuru-intro-seen', '1');
        return hasSeen;
      } catch {
        return true;
      }
    })();

    const duration = reduced ? 60 : seen ? 340 : 920;
    const exitDuration = reduced ? 1 : 380;
    const startedAt = performance.now();
    let readyAt = document.readyState === 'complete' ? startedAt : null;
    let frame = 0;
    let released = false;

    const renderProgress = (value) => {
      const next = Math.max(0, Math.min(100, Math.round(value)));
      loader.style.setProperty('--loader-progress', `${next}%`);
      progressbar?.setAttribute('aria-valuenow', String(next));
      if (progressText) progressText.textContent = String(next).padStart(3, '0');
    };

    const release = () => {
      if (released) return;
      released = true;
      renderProgress(100);
      loader.classList.add('loaded');
      loader.dataset.state = 'ready';
      if (stateText) stateText.textContent = 'READY';
      root.dataset.loaderReleased = 'true';

      window.setTimeout(() => {
        document.body.classList.remove('site-loading');
        loader.setAttribute('aria-hidden', 'true');
        document.dispatchEvent(new CustomEvent('ivuru:loader-released'));
      }, exitDuration);
    };

    const tick = (now) => {
      const elapsed = now - startedAt;
      const waiting = Math.min(88, (elapsed / Math.max(duration, 1)) * 88);
      const readyRatio =
        readyAt === null ? 0 : Math.min(1, (now - readyAt) / Math.max(duration * 0.18, 1));
      renderProgress(waiting + (100 - waiting) * readyRatio);

      if ((readyAt !== null && elapsed >= duration) || elapsed >= duration + 450) {
        release();
        return;
      }

      frame = requestAnimationFrame(tick);
    };

    const markReady = () => {
      readyAt ??= performance.now();
    };

    document.body.classList.add('site-loading');
    loader.dataset.state = 'loading';
    renderProgress(0);
    if (readyAt === null) window.addEventListener('load', markReady, { once: true });
    frame = requestAnimationFrame(tick);

    window.addEventListener(
      'pagehide',
      () => {
        cancelAnimationFrame(frame);
        window.removeEventListener('load', markReady);
        document.body.classList.remove('site-loading');
      },
      { once: true },
    );
  })();
</script>

<style>
  :global(.world-loader.anime-intro-loader.orbital-loader) {
    --loader-bg: #0a0a0c;
    --loader-white: #f8fbff;
    --loader-blue: #55c8ff;
    --loader-cyan: #b8efff;
    --loader-gold: #e8c878;
    --loader-muted: rgb(225 234 245 / 46%);
    --loader-line: rgb(187 225 255 / 14%);
    --loader-ease: cubic-bezier(0.16, 1, 0.3, 1);

    position: fixed;
    z-index: 6000;
    inset: 0;
    display: grid;
    grid-template-rows: auto 1fr auto auto;
    box-sizing: border-box;
    min-height: 100svh;
    overflow: hidden;
    padding: max(26px, env(safe-area-inset-top)) max(28px, env(safe-area-inset-right))
      max(26px, env(safe-area-inset-bottom)) max(28px, env(safe-area-inset-left));
    color: var(--loader-white);
    background:
      radial-gradient(circle at 50% 45%, rgb(37 128 176 / 8%), transparent 31%),
      linear-gradient(160deg, #0b0b0e, #08090c 58%, #0a0a0c);
    clip-path: none;
    opacity: 1;
    visibility: visible;
    transform: translateZ(0) scale(1);
    transition:
      opacity 380ms var(--loader-ease),
      visibility 380ms var(--loader-ease),
      transform 520ms var(--loader-ease);
    isolation: isolate;
  }

  :global(.world-loader.anime-intro-loader.orbital-loader::before) {
    position: absolute;
    inset: 0;
    content: '';
    pointer-events: none;
    background:
      linear-gradient(90deg, transparent 0 49.96%, rgb(255 255 255 / 2.5%) 50%, transparent 50.04%),
      linear-gradient(transparent 0 49.96%, rgb(255 255 255 / 2%) 50%, transparent 50.04%);
    mask-image: radial-gradient(circle at center, #000, transparent 70%);
    opacity: 0.54;
  }

  :global(.world-loader.anime-intro-loader.orbital-loader::after) {
    position: absolute;
    inset: 0;
    content: '';
    pointer-events: none;
    background: radial-gradient(circle at center, transparent 44%, rgb(0 0 0 / 44%) 100%);
    animation: none;
  }

  :global(.orbital-loader.loaded),
  :global(.orbital-loader[data-failsafe-hidden='true']) {
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transform: translateZ(0) scale(1.012);
  }

  .orbital-loader__chrome {
    position: relative;
    z-index: 4;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    color: var(--loader-muted);
    font:
      620 0.58rem/1.4 ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;
    letter-spacing: 0.17em;
  }

  .orbital-loader__stage {
    position: relative;
    z-index: 2;
    display: grid;
    min-height: 280px;
    place-items: center;
    perspective: 1200px;
    transform-style: preserve-3d;
  }

  .orbital-system {
    position: relative;
    width: clamp(240px, 31vw, 370px);
    aspect-ratio: 1;
    transform-style: preserve-3d;
    animation: orbital-breathe 3.8s var(--loader-ease) infinite;
  }

  .orbital-bloom {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 42%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: rgb(74 190 240 / 18%);
    filter: blur(42px);
    transform: translate3d(-50%, -50%, -24px);
  }

  .orbital-axis {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 86%;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgb(184 239 255 / 14%), transparent);
    transform-origin: center;
  }

  .orbital-axis--x {
    transform: translate3d(-50%, -50%, -20px) rotate(24deg);
  }

  .orbital-axis--y {
    transform: translate3d(-50%, -50%, -20px) rotate(114deg);
  }

  .orbital-ring {
    position: absolute;
    border: 1px solid var(--loader-line);
    border-radius: 50%;
    transform-style: preserve-3d;
  }

  .orbital-ring i {
    position: absolute;
    top: 50%;
    left: -3px;
    width: 6px;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--loader-white);
    box-shadow: 0 0 18px rgb(184 239 255 / 56%);
    transform: translateY(-50%);
  }

  .orbital-ring--outer {
    inset: 7%;
    border-color: rgb(184 239 255 / 19%);
    animation: orbital-outer 8.8s linear infinite;
  }

  .orbital-ring--middle {
    inset: 18%;
    border-color: rgb(232 200 120 / 23%);
    animation: orbital-middle 7.2s linear infinite reverse;
  }

  .orbital-ring--middle i {
    background: var(--loader-gold);
    box-shadow: 0 0 16px rgb(232 200 120 / 46%);
  }

  .orbital-ring--inner {
    inset: 29%;
    border-style: dashed;
    border-color: rgb(255 255 255 / 16%);
    animation: orbital-inner 5.6s linear infinite;
  }

  .orbital-core {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 31%;
    aspect-ratio: 1;
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 22%);
    border-radius: 50%;
    background: radial-gradient(
      circle at 31% 24%,
      #fff 0 3%,
      #d8f6ff 9%,
      #73d4fa 27%,
      #276b8d 59%,
      #0a1821 100%
    );
    box-shadow:
      inset -18px -20px 34px rgb(0 0 0 / 46%),
      0 0 0 1px rgb(85 200 255 / 8%),
      0 0 44px rgb(85 200 255 / 16%);
    transform: translate3d(-50%, -50%, 58px);
  }

  .orbital-core i {
    position: absolute;
    inset: -7%;
    border-radius: inherit;
    background: #071017;
    opacity: 0.76;
    transform: translate3d(54%, 0, 2px);
    animation: orbital-phase 3.6s var(--loader-ease) infinite alternate;
  }

  .orbital-core b {
    position: absolute;
    top: 20%;
    left: 24%;
    width: 13%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: rgb(255 255 255 / 78%);
    filter: blur(3px);
  }

  .orbital-point {
    position: absolute;
    width: 3px;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--loader-cyan);
    box-shadow: 0 0 12px rgb(184 239 255 / 50%);
  }

  .orbital-point--a {
    top: 18%;
    right: 19%;
  }

  .orbital-point--b {
    bottom: 21%;
    left: 17%;
    background: var(--loader-gold);
    box-shadow: 0 0 12px rgb(232 200 120 / 40%);
  }

  .orbital-loader__copy {
    position: relative;
    z-index: 4;
    display: grid;
    justify-items: center;
    margin-top: -8px;
    text-align: center;
  }

  .orbital-loader__copy p,
  .orbital-loader__copy span {
    margin: 0;
    color: var(--loader-muted);
    font:
      620 0.59rem/1.5 ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .orbital-loader__copy strong {
    margin: 12px 0 9px;
    color: var(--loader-white);
    font-size: clamp(2.8rem, 6.5vw, 5.2rem);
    font-weight: 760;
    line-height: 0.9;
    letter-spacing: -0.11em;
    text-shadow: 0 18px 50px rgb(70 177 225 / 13%);
  }

  .orbital-loader__footer {
    position: relative;
    z-index: 4;
    display: grid;
    grid-template-columns: 1fr minmax(220px, 320px);
    gap: 24px;
    align-items: end;
    padding-top: 20px;
  }

  .orbital-loader__metadata {
    display: flex;
    flex-wrap: wrap;
    gap: 9px 24px;
    color: var(--loader-muted);
    font:
      600 0.55rem/1.4 ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;
    letter-spacing: 0.13em;
  }

  .orbital-loader__metadata b {
    color: var(--loader-cyan);
    font-weight: inherit;
  }

  .orbital-loader__progress {
    display: grid;
    grid-template-columns: 1fr 3ch;
    gap: 12px;
    align-items: center;
  }

  .orbital-loader__progress > span {
    position: relative;
    height: 1px;
    overflow: hidden;
    background: rgb(255 255 255 / 10%);
  }

  .orbital-loader__progress i {
    position: absolute;
    inset: 0 auto 0 0;
    width: var(--loader-progress);
    background: linear-gradient(90deg, var(--loader-blue), var(--loader-cyan));
    box-shadow: 0 0 12px rgb(85 200 255 / 34%);
    transition: width 80ms linear;
  }

  .orbital-loader__progress > b {
    color: var(--loader-white);
    font:
      620 0.64rem/1 ui-monospace,
      SFMono-Regular,
      Menlo,
      monospace;
    letter-spacing: 0.08em;
  }

  @keyframes orbital-outer {
    from {
      transform: rotateX(70deg) rotateZ(0deg);
    }
    to {
      transform: rotateX(70deg) rotateZ(360deg);
    }
  }

  @keyframes orbital-middle {
    from {
      transform: rotateY(67deg) rotateZ(0deg);
    }
    to {
      transform: rotateY(67deg) rotateZ(360deg);
    }
  }

  @keyframes orbital-inner {
    from {
      transform: rotateX(36deg) rotateY(52deg) rotateZ(0deg);
    }
    to {
      transform: rotateX(36deg) rotateY(52deg) rotateZ(360deg);
    }
  }

  @keyframes orbital-phase {
    from {
      transform: translate3d(68%, -1%, 2px) scale(1.04);
    }
    to {
      transform: translate3d(30%, 1%, 2px) scale(1.02);
    }
  }

  @keyframes orbital-breathe {
    0%,
    100% {
      transform: translate3d(0, 2px, 0) scale(0.997);
    }
    50% {
      transform: translate3d(0, -4px, 0) scale(1.008);
    }
  }

  @media (max-width: 680px) {
    :global(.world-loader.anime-intro-loader.orbital-loader) {
      padding-inline: max(18px, env(safe-area-inset-left));
    }

    .orbital-loader__chrome span:first-child,
    .orbital-loader__metadata span:last-child {
      display: none;
    }

    .orbital-loader__chrome {
      justify-content: flex-end;
    }

    .orbital-system {
      width: min(76vw, 310px);
    }

    .orbital-loader__footer {
      grid-template-columns: 1fr;
      gap: 14px;
    }

    .orbital-loader__metadata {
      justify-content: center;
    }
  }

  @media (max-height: 620px) {
    :global(.world-loader.anime-intro-loader.orbital-loader) {
      padding-block: 14px;
    }

    .orbital-loader__stage {
      min-height: 190px;
    }

    .orbital-system {
      width: min(43vh, 240px);
    }

    .orbital-loader__copy strong {
      font-size: 2.7rem;
    }

    .orbital-loader__copy span,
    .orbital-loader__metadata span:last-child {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.world-loader.anime-intro-loader.orbital-loader),
    .orbital-loader__progress i {
      transition-duration: 1ms !important;
    }

    .orbital-system,
    .orbital-ring,
    .orbital-core i {
      animation: none !important;
    }

    .orbital-core i {
      transform: translate3d(44%, 0, 2px);
    }
  }

  :global(html[data-document-active='false']) .orbital-system,
  :global(html[data-document-active='false']) .orbital-ring,
  :global(html[data-document-active='false']) .orbital-core i {
    animation-play-state: paused !important;
  }
</style>
