<script is:inline data-astro-rerun>
  (() => {
    const cleanupKey = '__ivuruLoaderReleaseGuardDispose';
    const root = document.documentElement;

    window[cleanupKey]?.();

    let readyTimer = 0;
    let hardTimer = 0;
    let hideTimer = 0;
    let loader = null;

    const markRuntimeSafe = (reason) => {
      if (!(loader instanceof HTMLElement)) return;
      loader.hidden = true;
      loader.style.display = 'none';
      loader.dataset.loaderRuntimeSafe = 'true';
      root.dataset.loaderRuntimeSafe = 'true';
      document.dispatchEvent(new CustomEvent('ivuru:loader-runtime-safe', { detail: { reason } }));
    };

    const releaseLoader = (reason) => {
      loader = document.querySelector('[data-spatial-loader]');
      if (!(loader instanceof HTMLElement)) return;
      if (loader.dataset.guardReleased === 'true') return;

      loader.dataset.guardReleased = 'true';
      loader.dataset.releaseReason = reason;
      loader.dataset.loaderRuntimeSafe = 'false';
      loader.dataset.state = 'ready';
      loader.classList.add('loaded');
      loader.setAttribute('aria-hidden', 'true');
      loader.style.pointerEvents = 'none';
      root.dataset.loaderReleased = 'true';
      root.dataset.loaderRuntimeSafe = 'false';
      document.body?.classList.remove('site-loading');

      const state = loader.querySelector('[data-loader-state]');
      const progress = loader.querySelector('[role="progressbar"]');
      const progressText = loader.querySelector('[data-loader-progress]');
      if (state) state.textContent = 'READY';
      progress?.setAttribute('aria-valuenow', '100');
      if (progressText) progressText.textContent = '100';
      loader.style.setProperty('--loader-progress', '100%');

      document.dispatchEvent(new CustomEvent('ivuru:loader-released', { detail: { reason } }));

      window.clearTimeout(hideTimer);
      hideTimer = window.setTimeout(() => markRuntimeSafe(reason), 580);
    };

    const armGuard = () => {
      loader = document.querySelector('[data-spatial-loader]');
      if (!(loader instanceof HTMLElement)) return;
      if (loader.dataset.releaseGuardBound === 'true') return;
      loader.dataset.releaseGuardBound = 'true';

      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const seen = (() => {
        try {
          return sessionStorage.getItem('ivuru-intro-seen') === '1';
        } catch {
          return true;
        }
      })();

      const readyDelay = reduced ? 120 : seen ? 2_400 : 3_500;
      const hardLimit = reduced ? 600 : seen ? 4_500 : 6_500;

      const armTimers = () => {
        if (!(loader instanceof HTMLElement) || loader.dataset.guardReleased === 'true') return;
        window.clearTimeout(readyTimer);
        window.clearTimeout(hardTimer);
        readyTimer = window.setTimeout(() => releaseLoader('animation-safety-release'), readyDelay);
        hardTimer = window.setTimeout(() => releaseLoader('hard-timeout'), hardLimit);
      };

      armTimers();

      window.addEventListener('wheel', onWheel, { once: true, passive: true });
      window.addEventListener('touchmove', onTouchMove, { once: true, passive: true });
      window.addEventListener('keydown', onKeyDown, { once: true });
      window.addEventListener('pageshow', onPageShow);
    };

    const onWheel = () => releaseLoader('wheel-input');
    const onTouchMove = () => releaseLoader('touch-input');
    const onKeyDown = () => releaseLoader('keyboard-input');
    const onPageShow = (event) => {
      if (event.persisted) releaseLoader('bfcache-restore');
    };
    const onPageLoad = () => armGuard();
    const onBeforeSwap = () => window[cleanupKey]?.();

    window[cleanupKey] = () => {
      window.clearTimeout(readyTimer);
      window.clearTimeout(hardTimer);
      window.clearTimeout(hideTimer);
      window.removeEventListener('wheel', onWheel);
      window.removeEventListener('touchmove', onTouchMove);
      window.removeEventListener('keydown', onKeyDown);
      window.removeEventListener('pageshow', onPageShow);
      document.removeEventListener('astro:page-load', onPageLoad);
      document.removeEventListener('astro:before-swap', onBeforeSwap);
      delete window[cleanupKey];
    };

    armGuard();
    document.addEventListener('astro:page-load', onPageLoad);
    document.addEventListener('astro:before-swap', onBeforeSwap, { once: true });
  })();
</script>
