---
import { localePath, type Locale } from '@/data/site-config';

const { locale } = Astro.props as { locale: Locale };
const copy = {
  ja: {
    kicker: 'NEXT SCENES',
    title: 'スクロールするたび、次の物語へ。',
    intro:
      'News、Games、Profile内のFavoritesを、同じオリジナルキャラクターが案内する3つのアニメシーンとしてまとめました。',
    news: ['News', 'サイトとプロジェクトの更新をノートに記録'],
    games: ['Games', 'ゲームクリップとプレイの思い出'],
    favorites: ['Profile / Favorites', '好きな音楽、ページ、コミュニティ'],
    enter: 'シーンを開く',
  },
  en: {
    kicker: 'NEXT SCENES',
    title: 'Scroll into the next little story.',
    intro:
      'News, Games, and Favorites inside Profile are presented as three anime scenes guided by the same original character.',
    news: ['News', 'Notes from the site and ongoing projects'],
    games: ['Games', 'Game clips and memorable sessions'],
    favorites: ['Profile / Favorites', 'Music, pages, and communities I love'],
    enter: 'Open scene',
  },
  ko: {
    kicker: 'NEXT SCENES',
    title: '스크롤할 때마다 다음 이야기로.',
    intro:
      'News, Games, Profile 안의 Favorites를 같은 오리지널 캐릭터가 안내하는 세 개의 애니메이션 장면으로 구성했습니다.',
    news: ['News', '사이트와 프로젝트의 업데이트 노트'],
    games: ['Games', '게임 클립과 플레이의 추억'],
    favorites: ['Profile / Favorites', '좋아하는 음악, 페이지, 커뮤니티'],
    enter: '장면 열기',
  },
}[locale];

const worlds = [
  {
    key: 'news',
    index: '01',
    href: '/news',
    media: '/assets/visuals/anime/ivuru-news-scene.svg',
  },
  {
    key: 'games',
    index: '02',
    href: '/games',
    media: '/assets/visuals/anime/ivuru-games-scene.svg',
  },
  {
    key: 'favorites',
    index: '03',
    href: '/profile#favorites',
    media: '/assets/visuals/anime/ivuru-favorites-scene.svg',
  },
] as const;
---

<section class="anime-portal-section section" data-world-zone="creative" data-anime-scene="blue">
  <div class="section-inner">
    <div class="anime-portal-heading" data-anime-reveal="heading">
      <div>
        <p class="editorial-kicker">{copy.kicker}</p>
        <h2>{copy.title}</h2>
      </div>
      <p>{copy.intro}</p>
    </div>
    <div class="anime-portal-grid" data-anime-stagger>
      {
        worlds.map((world, index) => {
          const item = copy[world.key];
          return (
            <a
              class="anime-portal-card"
              href={localePath(locale, world.href)}
              data-anime-card
              data-analytics-event="world_portal_open"
              data-analytics-target={world.key}
              data-analytics-surface="home_anime_portal"
              data-analytics-position={String(index + 1)}
            >
              <div data-anime-visual>
                <img src={world.media} alt="" width="1200" height="800" loading="lazy" />
              </div>
              <div class="anime-portal-card-copy">
                <small>
                  {world.index} / {world.key.toUpperCase()}
                </small>
                <h3>{item[0]}</h3>
                <p>{item[1]}</p>
                <span>{copy.enter} ↗</span>
              </div>
            </a>
          );
        })
      }
    </div>
  </div>
</section>
