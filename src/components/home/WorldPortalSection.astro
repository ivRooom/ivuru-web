---
import { localePath, type Locale } from '@/data/site-config';

const { locale } = Astro.props as { locale: Locale };
const copy = {
  ja: {
    kicker: 'BLUE CHANNELS',
    title: 'スクロールの先に、次のチャンネルがひらく。',
    intro:
      'News、Games、Profile内のFavoritesを、同じ青白アニメ世界からつながる3つのメディアチャンネルとしてまとめました。',
    news: ['News', '開発とプロジェクトの更新を記録するシグナルノート'],
    games: ['Games', 'ゲームクリップとプレイの熱量を残すチャンネル'],
    favorites: ['Profile / Favorites', '音楽、ページ、コミュニティを集めたお気に入りアーカイブ'],
    enter: 'チャンネルを開く',
  },
  en: {
    kicker: 'BLUE CHANNELS',
    title: 'Every scroll opens the next channel.',
    intro:
      'News, Games, and Favorites inside Profile are connected as three media channels from the same blue-and-white anime world.',
    news: ['News', 'A signal note for development and project updates'],
    games: ['Games', 'A channel for clips and the energy of play'],
    favorites: ['Profile / Favorites', 'An archive of music, pages, and communities'],
    enter: 'Open channel',
  },
  ko: {
    kicker: 'BLUE CHANNELS',
    title: '스크롤 너머에서 다음 채널이 열립니다.',
    intro:
      'News, Games, Profile의 Favorites를 같은 파랑과 흰색 애니메이션 세계에서 이어지는 세 개의 미디어 채널로 구성했습니다.',
    news: ['News', '개발과 프로젝트 업데이트를 기록하는 시그널 노트'],
    games: ['Games', '게임 클립과 플레이의 열기를 남기는 채널'],
    favorites: ['Profile / Favorites', '음악, 페이지, 커뮤니티를 모은 즐겨찾기 아카이브'],
    enter: '채널 열기',
  },
}[locale];

const worlds = [
  {
    key: 'news',
    index: '01',
    href: '/news',
    monogram: 'N',
    signal: 'LOG / UPDATE',
  },
  {
    key: 'games',
    index: '02',
    href: '/games',
    monogram: 'G',
    signal: 'PLAY / CLIP',
  },
  {
    key: 'favorites',
    index: '03',
    href: '/profile#favorites',
    monogram: 'F',
    signal: 'SAVE / MEMORY',
  },
] as const;
---

<section class="anime-portal-section section" data-world-zone="creative" data-anime-scene="deep">
  <div class="section-inner">
    <div class="anime-portal-heading" data-anime-reveal="heading" data-blue-reveal>
      <div>
        <p class="editorial-kicker">{copy.kicker}</p>
        <h2 data-glitch={copy.title}>{copy.title}</h2>
      </div>
      <p>{copy.intro}</p>
    </div>
    <div class="anime-portal-grid" data-anime-stagger>
      {
        worlds.map((world, index) => {
          const item = copy[world.key];
          return (
            <a
              class="anime-portal-card signal-channel-card"
              href={localePath(locale, world.href)}
              data-anime-card
              data-cinematic-card
              data-channel={world.key}
              data-analytics-event="world_portal_open"
              data-analytics-target={world.key}
              data-analytics-surface="home_blue_channel"
              data-analytics-position={String(index + 1)}
            >
              <div class="cinematic-card-surface">
                <div class="signal-channel-visual" data-anime-visual data-blue-visual aria-hidden="true">
                  <span class="signal-channel-grid"></span>
                  <span class="signal-channel-orbit orbit-a"></span>
                  <span class="signal-channel-orbit orbit-b"></span>
                  <span class="signal-channel-scan"></span>
                  <strong>{world.monogram}</strong>
                  <small>{world.signal}</small>
                  <div class="signal-channel-spectrum">
                    <i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i>
                  </div>
                  <span class="signal-channel-index">CH / {world.index}</span>
                </div>
                <div class="anime-portal-card-copy">
                  <small>
                    {world.index} / {world.key.toUpperCase()}
                  </small>
                  <h3>{item[0]}</h3>
                  <p>{item[1]}</p>
                  <span>{copy.enter} ↗</span>
                </div>
              </div>
            </a>
          );
        })
      }
    </div>
  </div>
</section>
