---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Code2, Cloud, Database, LayoutTemplate, Network, Workflow } from 'lucide-react';
import { siteConfig, localePath, type Locale } from '@/data/site-config';
import { getDictionary } from '@/i18n/dictionaries';
const { locale } = Astro.props as { locale: Locale };
const d = getDictionary(locale);
const areas = [
  [LayoutTemplate, 'Frontend Development', 'HTML / CSS / JavaScript / React / TypeScript'],
  [Code2, 'UI Implementation', 'Responsive / Accessibility / Animation'],
  [Network, 'API Integration', 'REST API / Data fetching / Error handling'],
  [Database, 'Backend & Database', 'Node.js / PostgreSQL — learning & building'],
  [Cloud, 'Cloud & Infrastructure', 'OCI / AWS / Cloudflare — learning & practice'],
  [Workflow, 'Automation', 'GitHub Actions / Operational tools'],
] as const;
const process = {
  ja: ['目的と利用者を整理', '情報設計と画面構成', 'UI実装とデータ連携', '検証・改善・公開'],
  en: ['Clarify goals and users', 'Structure content and screens', 'Implement UI and data flows', 'Test, refine, and release'],
  ko: ['목표와 사용자 정리', '정보 구조와 화면 구성', 'UI 구현과 데이터 연동', '검증, 개선, 공개'],
}[locale];
const consoleCopy = {
  ja: {
    online: 'SYSTEM ONLINE',
    command: 'Contact Terminalへ接続',
    description: '要件整理からUI実装、検証、公開まで、実装を中心にプロジェクトを進めます。',
    contact: 'お問い合わせを開始',
  },
  en: {
    online: 'SYSTEM ONLINE',
    command: 'Connect to Contact Terminal',
    description: 'From requirements and UI implementation to validation and release, with a strong focus on building.',
    contact: 'Start an inquiry',
  },
  ko: {
    online: 'SYSTEM ONLINE',
    command: 'Contact Terminal 연결',
    description: '요구사항 정리부터 UI 구현, 검증, 공개까지 구현을 중심으로 진행합니다.',
    contact: '문의 시작',
  },
}[locale];
---

<BaseLayout
  title={`${d.portfolio.title} — ${siteConfig.name} / ${siteConfig.idName}`}
  description={d.portfolio.intro}
  locale={locale}
  chapter={{ code: '03', title: 'SYSTEM CONSOLE', world: 'DEVELOPER WORLD' }}
>
  <header class="page-hero portfolio-hero developer-console-hero page-grid-bg" data-page-intro>
    <div class="page-hero-inner">
      <p class="eyebrow">DEVELOPER WORLD / SYSTEM CONSOLE</p>
      <h1 class="page-title"><span>Developer</span> <span>Portfolio</span></h1>
      <p>{d.portfolio.intro}</p>
      <div class="console-status-line"><i></i><span>{consoleCopy.online}</span><code>node: ivuru-dev-01</code></div>
    </div>
  </header>

  <section class="developer-console section" data-world-zone="developer">
    <div class="section-inner console-window" data-reveal>
      <header class="console-window-bar">
        <div><span></span><span></span><span></span></div>
        <code>ivuru@developer-world:~/portfolio</code>
        <b>{consoleCopy.online}</b>
      </header>
      <div class="console-command-output">
        <code>$ whoami --capabilities</code>
        <h2>{d.portfolio.areas}</h2>
        <p>{consoleCopy.description}</p>
      </div>
      <div class="area-list console-module-grid">
        {areas.map(([Icon, title, body], index) => (
          <article data-reveal>
            <header><span>MOD-{String(index + 1).padStart(2, '0')}</span><Icon aria-hidden="true" /></header>
            <h3>{title}</h3>
            <p>{body}</p>
            <small>STATUS / READY</small>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="process console-process section" data-world-zone="day">
    <div class="section-inner">
      <div class="section-heading" data-reveal>
        <div><p class="section-kicker">PIPELINE / IDEA → RELEASE</p><h2>{d.portfolio.process}</h2></div>
      </div>
      <ol>
        {process.map((item, index) => (
          <li data-reveal>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <div><small>PROCESS NODE</small><h3>{item}</h3></div>
            <i aria-hidden="true" />
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="portfolio-principles console-principles section" data-world-zone="night">
    <div class="section-inner">
      <div class="section-heading" data-reveal>
        <div><p class="section-kicker">CORE DIRECTIVES</p><h2>{d.portfolio.principles}</h2></div>
      </div>
      <div class="principles">
        <article><small>DIR-01</small><h3>Clarity</h3><p>{locale === 'ja' ? '情報階層と視線の流れを整え、迷わず使える画面をつくります。' : locale === 'en' ? 'Clear hierarchy and flow help people move without friction.' : '명확한 정보 구조와 흐름으로 망설임 없이 사용할 수 있게 합니다.'}</p></article>
        <article><small>DIR-02</small><h3>Maintainability</h3><p>{locale === 'ja' ? 'データとUIを分離し、更新・拡張しやすい実装を目指します。' : locale === 'en' ? 'Separating data from UI keeps the product easy to update and extend.' : '데이터와 UI를 분리해 업데이트와 확장이 쉬운 구현을 지향합니다.'}</p></article>
        <article><small>DIR-03</small><h3>Performance</h3><p>{locale === 'ja' ? '演出と表示速度を両立し、端末特性に合わせて段階的に体験を調整します。' : locale === 'en' ? 'Motion and speed are balanced with progressive experiences for each device.' : '연출과 속도를 균형 있게 설계하고 기기에 맞게 경험을 조정합니다.'}</p></article>
      </div>
    </div>
  </section>

  <section class="contact-cta console-contact-cta section" data-reveal>
    <div class="cta-orbit" aria-hidden="true"></div>
    <p class="section-kicker">{d.portfolio.inquiries}</p>
    <h2>{consoleCopy.command}</h2>
    <p>{consoleCopy.description}</p>
    <a class="secondary-button" href={localePath(locale, '/contact')}>{consoleCopy.contact} →</a>
  </section>
</BaseLayout>
