---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { newsCategoryLabels, newsItems } from '@/data/news';
import { localePath, siteConfig, type Locale } from '@/data/site-config';

const { locale } = Astro.props as { locale: Locale };
const copy = {
  ja: { title: 'News', lead: 'サイト、制作、コミュニティに関する更新を、読みやすい時系列でまとめています。', latest: 'Latest updates', latestIntro: '新しい順に、変更点と活動記録を確認できます。', open: '詳細を見る', local: 'サイト内のお知らせ', back: 'ホームへ戻る' },
  en: { title: 'News', lead: 'A clear chronological record of updates across the site, projects, and community.', latest: 'Latest updates', latestIntro: 'Browse changes and activity notes from newest to oldest.', open: 'View details', local: 'Site update', back: 'Back home' },
  ko: { title: 'News', lead: '사이트, 프로젝트, 커뮤니티의 업데이트를 읽기 쉬운 시간순으로 정리합니다.', latest: 'Latest updates', latestIntro: '최신 변경 사항과 활동 기록을 확인할 수 있습니다.', open: '자세히 보기', local: '사이트 공지', back: '홈으로' },
}[locale];
const categories = newsCategoryLabels[locale];
const formatter = new Intl.DateTimeFormat(locale === 'ja' ? 'ja-JP' : locale === 'ko' ? 'ko-KR' : 'en-US', { year: 'numeric', month: 'short', day: '2-digit' });
---

<BaseLayout title={`${copy.title} — ${siteConfig.name} / ${siteConfig.idName}`} description={copy.lead} locale={locale}>
  <header class="official-page-hero"><div class="official-shell"><p class="official-page-label">Updates / Activity</p><h1>{copy.title}</h1><p>{copy.lead}</p><a class="official-text-link" href={localePath(locale, '/')}>{copy.back} →</a></div></header>
  <section class="official-section"><div class="official-shell"><div class="official-section__heading"><h2>{copy.latest}</h2><p>{copy.latestIntro}</p></div><div class="official-news-list" role="list">{newsItems.map((item, index) => <article class="official-news-item" role="listitem"><div class="official-news-item__meta"><span>{String(index + 1).padStart(2, '0')}</span><time datetime={item.publishedAt}>{formatter.format(new Date(`${item.publishedAt}T00:00:00Z`))}</time><span>{categories[item.category]}</span></div><div><h2>{item.title[locale]}</h2><p>{item.summary[locale]}</p></div>{item.href ? <a class="official-project__arrow" href={item.href} target="_blank" rel="noopener noreferrer" aria-label={copy.open}>↗</a> : <span class="official-news-local">{copy.local}</span>}</article>)}</div></div></section>
</BaseLayout>
