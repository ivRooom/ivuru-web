---
import BaseLayout from '@/layouts/BaseLayout.astro';
import WorkFilter from '@/components/works/WorkFilter';
import { projects } from '@/data/projects';
import { profile } from '@/data/profile';
import { localePath, siteConfig, type Locale } from '@/data/site-config';
import { getDictionary } from '@/i18n/dictionaries';
const { locale } = Astro.props as { locale: Locale };
const d = getDictionary(locale);
const copy = {
  ja: {
    select: 'ミッションを選択', active: '稼働中', route: 'ルートを開く', archive: '全ワールド記録',
    briefing: '制作・ゲーム・コミュニティ・創作の活動を、ミッションデータとして記録しています。',
    stack: 'Developer技術スタック', stackIntro: '実務・個人開発・学習中を分け、現在の技術領域をCapability Matrixとして表示します。',
    portfolio: '設計思想・技術構成・開発プロセスを詳しく見る', openPortfolio: 'Developer Consoleを開く',
  },
  en: {
    select: 'Select a mission', active: 'Live', route: 'Open route', archive: 'All world records',
    briefing: 'Development, gaming, community, and creative activity recorded as mission data.',
    stack: 'Developer Technology Stack', stackIntro: 'Current capabilities shown by production, project, and learning status.',
    portfolio: 'Explore design decisions, architecture, and development process.', openPortfolio: 'Open Developer Console',
  },
  ko: {
    select: '미션 선택', active: '가동 중', route: '루트 열기', archive: '전체 월드 기록',
    briefing: '개발, 게임, 커뮤니티, 창작 활동을 미션 데이터로 기록합니다.',
    stack: 'Developer 기술 스택', stackIntro: '실무, 개인 프로젝트, 학습 상태로 현재 기술 영역을 표시합니다.',
    portfolio: '설계 사상, 기술 구성, 개발 프로세스를 자세히 확인합니다.', openPortfolio: 'Developer Console 열기',
  },
}[locale];
---

<BaseLayout
  title={`${d.works.title} — ${siteConfig.name} / ${siteConfig.idName}`}
  description={d.works.intro}
  locale={locale}
  chapter={{ code: '02', title: 'MISSION ARCHIVE', world: 'CREATIVE WORLD' }}
>
  <header class="page-hero works-hero mission-world page-grid-bg" data-page-intro>
    <div class="page-hero-inner">
      <p class="eyebrow">WORLD SELECT / {projects.length.toString().padStart(2, '0')}</p>
      <h1 class="page-title">{d.works.title}</h1>
      <p>{copy.briefing}</p>
      <div class="mission-route-map" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
    </div>
  </header>

  <section class="works-page mission-select section" data-world-zone="mission">
    <div class="section-inner">
      <div class="mission-console-bar" data-reveal>
        <div><small>MISSION CONTROL</small><strong>{copy.select}</strong></div>
        <span><i></i>{copy.active}</span>
        <code>WORLD://IVURU/WORKS</code>
      </div>

      <WorkFilter client:load noResults={d.common.noResults} />

      <div class="mission-layout">
        <aside class="mission-map" aria-label={copy.archive} data-reveal>
          <p>WORLD ROUTES</p>
          {projects.map((project, index) => (
            <a href={`#mission-${project.slug}`}>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <i class={`accent-${project.accent}`}></i>
              <b>{project.category}</b>
            </a>
          ))}
        </aside>

        <div class="works-grid mission-grid">
          {projects.map((project, index) => (
            <article
              id={`mission-${project.slug}`}
              class={`work-card mission-card accent-${project.accent}`}
              data-work-card
              data-category={project.category}
              data-reveal
            >
              <a href={localePath(locale, `/works/${project.slug}`)}>
                <div class="work-card-visual mission-visual" transition:name={`work-cover-${project.slug}`}>
                  <span class="mission-number">MISSION / {String(index + 1).padStart(2, '0')}</span>
                  <div class="mission-orbit" aria-hidden="true"><i></i><i></i><i></i></div>
                  <small>{project.category}</small>
                </div>
                <div class="work-card-copy mission-copy">
                  <div class="mission-card-status">
                    <span>{project.status}</span><small>{project.year}</small>
                  </div>
                  <h2>{project.title}</h2>
                  <p>{project.description[locale]}</p>
                  <div class="project-tech">
                    {project.technologies.map((tech) => <span class="chip">{tech}</span>)}
                  </div>
                  {project.sample && <small class="sample-label">{d.common.sample}</small>}
                  <span class="mission-open">{copy.route} →</span>
                </div>
              </a>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="developer-capability-hub section" data-world-zone="developer">
    <div class="section-inner">
      <div class="section-heading" data-reveal>
        <div><p class="section-kicker">CAPABILITY MATRIX</p><h2>{copy.stack}</h2></div>
        <p class="section-intro">{copy.stackIntro}</p>
      </div>
      <div class="developer-stack-matrix">
        {Object.entries(profile.stack).map(([group, items], index) => (
          <article data-reveal>
            <header><small>STACK / {String(index + 1).padStart(2, '0')}</small><h3>{group}</h3></header>
            <div>{items.map((item) => <span data-status={item.status}><b>{item.name}</b><small>{d.profile.statuses[item.status]}</small></span>)}</div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="portfolio-gateway section" data-world-zone="developer">
    <div class="section-inner portfolio-gateway-panel" data-reveal>
      <div><small>DEVELOPER CONSOLE / ACCESS POINT</small><h2>Portfolio</h2><p>{copy.portfolio}</p></div>
      <a class="button-primary" href={localePath(locale, '/portfolio')}>{copy.openPortfolio} →</a>
      <div class="gateway-lines" aria-hidden="true"><i></i><i></i><i></i></div>
    </div>
  </section>
</BaseLayout>
