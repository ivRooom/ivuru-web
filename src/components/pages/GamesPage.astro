---
import BaseLayout from '@/layouts/BaseLayout.astro';
import AdaptiveLoopVideo from '@/components/common/AdaptiveLoopVideo';
import { gameWorlds } from '@/data/game-worlds';
import { localePath, siteConfig, type Locale } from '@/data/site-config';
import '@/styles/editorial-refresh.css';

const { locale } = Astro.props as { locale: Locale };
const copy = {
  ja: {
    kicker: 'GAMES / PERSONAL NOTES',
    title: '遊んだ時間を、静かに残す。',
    subtitle: 'Clips, sessions, and game notes',
    description:
      '派手な演出を足すのではなく、ゲームで感じたスピード、協力、競争の空気を短い映像と記録でまとめています。',
    notes: ['LOCAL VIDEO', 'NO AUTOPLAY WITH DATA SAVER', 'REDUCED MOTION READY'],
    section: 'Motion studies',
    sectionTitle: 'ゲームの空気を切り取った、3つの短い記録。',
    sectionIntro:
      '映像は画面内に入ったときだけ読み込み、タブが非表示のときは停止します。装飾よりも内容が先に伝わる構成へ整理しました。',
    concept: 'ORIGINAL MOTION STUDY',
    playTitle: '好きなのは、勝敗だけではない。',
    playBody:
      'FPSの判断速度、サンドボックスの試行錯誤、協力プレイの会話。ゲームを通して生まれる過程や関係性まで含めて記録していきます。',
    home: 'ホームへ戻る',
    profile: 'ProfileのFavoritesを見る',
  },
  en: {
    kicker: 'GAMES / PERSONAL NOTES',
    title: 'Keep the time spent playing.',
    subtitle: 'Clips, sessions, and game notes',
    description:
      'Instead of adding spectacle, this page keeps short records of speed, cooperation, and competition felt through games.',
    notes: ['LOCAL VIDEO', 'NO AUTOPLAY WITH DATA SAVER', 'REDUCED MOTION READY'],
    section: 'Motion studies',
    sectionTitle: 'Three short records of how a game felt.',
    sectionIntro:
      'Clips load only near the viewport and stop while the tab is hidden. The layout puts the record before the decoration.',
    concept: 'ORIGINAL MOTION STUDY',
    playTitle: 'Games are more than a result.',
    playBody:
      'Fast decisions in FPS games, iteration in sandboxes, and conversation in co-op sessions are all part of what I want to keep.',
    home: 'Back home',
    profile: 'See Favorites in Profile',
  },
  ko: {
    kicker: 'GAMES / PERSONAL NOTES',
    title: '플레이한 시간을 조용히 기록하다.',
    subtitle: 'Clips, sessions, and game notes',
    description:
      '화려한 장식을 더하기보다 게임에서 느낀 속도, 협력, 경쟁의 분위기를 짧은 영상과 기록으로 정리합니다.',
    notes: ['LOCAL VIDEO', 'NO AUTOPLAY WITH DATA SAVER', 'REDUCED MOTION READY'],
    section: 'Motion studies',
    sectionTitle: '게임의 분위기를 담은 세 개의 짧은 기록.',
    sectionIntro:
      '영상은 화면 가까이에서만 불러오고 탭이 숨겨지면 정지합니다. 장식보다 기록이 먼저 보이도록 구성했습니다.',
    concept: 'ORIGINAL MOTION STUDY',
    playTitle: '게임은 결과만으로 남지 않는다.',
    playBody:
      'FPS의 빠른 판단, 샌드박스의 시행착오, 협동 플레이의 대화까지 게임에서 생기는 과정과 관계를 함께 기록합니다.',
    home: '홈으로 돌아가기',
    profile: 'Profile의 Favorites 보기',
  },
}[locale];
---

<BaseLayout
  title={`Games — ${siteConfig.name} / ${siteConfig.idName}`}
  description={copy.description}
  locale={locale}
  image="/assets/visuals/editorial/game-room-sketch.svg"
  chapter={{ code: '04', title: 'GAMES', world: 'PERSONAL ARCHIVE' }}
>
  <header class="editorial-page-hero" data-page-intro>
    <div class="editorial-page-hero-inner">
      <div class="editorial-page-hero-copy">
        <p class="editorial-kicker">{copy.kicker}</p>
        <h1>{copy.title}<span>{copy.subtitle}</span></h1>
        <p class="editorial-lede">{copy.description}</p>
        <div class="editorial-hero-note" aria-label="Media behavior">
          {copy.notes.map((note) => <span>{note}</span>)}
        </div>
      </div>
      <figure class="editorial-hero-illustration">
        <img
          src="/assets/visuals/editorial/game-room-sketch.svg"
          alt=""
          width="1200"
          height="800"
          loading="eager"
        />
      </figure>
    </div>
  </header>

  <section class="editorial-game-section section" data-world-zone="gamer">
    <div class="section-inner">
      <div class="editorial-section-heading" data-reveal>
        <div>
          <p class="editorial-kicker">{copy.section}</p>
          <h2>{copy.sectionTitle}</h2>
        </div>
        <p>{copy.sectionIntro}</p>
      </div>

      <div class="editorial-game-list">
        {
          gameWorlds.map((world, index) => (
            <article class="editorial-game-card" data-reveal>
              <div class="editorial-game-media">
                <AdaptiveLoopVideo
                  client:visible
                  webm={world.webm}
                  mp4={world.mp4}
                  poster={world.poster}
                  title={world.title}
                  className="editorial-game-video"
                />
              </div>
              <div class="editorial-game-copy">
                <span class="editorial-game-number">
                  {String(index + 1).padStart(2, '0')} / {copy.concept}
                </span>
                <h2>{world.title}</h2>
                <strong>{world.subtitle[locale]}</strong>
                <p>{world.description[locale]}</p>
                <div class="editorial-tags">
                  {world.tags.map((tag) => (
                    <span>{tag}</span>
                  ))}
                </div>
              </div>
            </article>
          ))
        }
      </div>

      <aside class="editorial-game-footnote" data-reveal>
        <h2>{copy.playTitle}</h2>
        <div>
          <p>{copy.playBody}</p>
          <div class="editorial-tags">
            <a href={localePath(locale, '/')}>{copy.home} ↗</a>
            <a href={`${localePath(locale, '/profile')}#favorites`}>{copy.profile} ↗</a>
          </div>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
