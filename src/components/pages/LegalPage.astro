---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { siteConfig, type Locale } from '@/data/site-config';
import { getDictionary } from '@/i18n/dictionaries';
const { locale, kind } = Astro.props as { locale: Locale; kind: 'privacy' | 'terms' };
const d = getDictionary(locale);
const title = d.legal[kind];
const legalCopy = {
  ja: {
    privacy: [
      [
        '基本方針',
        'いゔる。は、本サイトおよび関連するコミュニティ・サービスで取り扱う情報を、目的に必要な範囲で適切に管理します。本ページは運用開始前の草案を含み、問い合わせ受付方法等の未確定事項は公開前に更新します。',
      ],
      [
        '取得する情報',
        'アクセス時の技術情報、Cookie・ローカルストレージに保存されるテーマ・言語・外部SNS表示の同意状態、お問い合わせ機能を実装した場合の氏名・メールアドレス・問い合わせ内容等を取得する場合があります。Discord・Minecraft連携を開始する場合は、対象項目を事前に明示します。',
      ],
      [
        '利用目的',
        'サイト表示、設定保持、問い合わせ対応、本人確認、荒らし・不正利用の防止、サービス・コミュニティの運営、品質改善、障害調査のために利用します。取得していない情報や、実施していない目的を前提とした利用は行いません。',
      ],
      [
        '外部SNS・外部サービス',
        'XおよびInstagramの埋め込みは、利用者が表示ボタンを押した後にのみ外部スクリプトを読み込みます。表示時には各事業者へIPアドレス、ブラウザ情報、Cookie等が送信される場合があります。Cloudflare、GitHubその他の利用サービスについても、各事業者の規約・プライバシーポリシーが適用されます。',
      ],
      [
        'Cookie・ローカルストレージ',
        'テーマ、言語、初回ロード演出、外部SNS表示の選択等を端末内に保存します。ブラウザ設定から削除できますが、一部の表示設定が初期化されます。アクセス解析を有効化する場合は、利用する事業者とオプトアウト方法を追記します。',
      ],
      [
        '第三者提供・国外サービス',
        '法令に基づく場合、安全確保のために必要な場合、または本人の同意がある場合を除き、取得情報を目的外で第三者へ提供しません。国外に拠点を持つクラウド・SNS事業者を利用する場合があります。',
      ],
      [
        '保存期間・安全管理',
        '目的に必要な期間に限り保存し、不要となった情報は削除または匿名化します。アクセス権限、ログ、バックアップ、認証情報を適切に管理し、問題発生時は影響範囲の確認と再発防止を行います。',
      ],
      [
        '開示・削除等の請求',
        '本人情報の開示、訂正、削除、利用停止等の受付方法は、Contact機能の公開時に案内します。本人確認や、法令・安全確保上の理由により対応できない場合があります。',
      ],
    ],
    terms: [
      [
        '適用範囲',
        '本規約は、いゔる。公式サイトおよび本サイトから案内する関連機能の利用に適用します。ivRm、Discord、Minecraft等に個別の規約・ガイドラインがある場合は、各文書が優先されます。',
      ],
      [
        '禁止事項',
        '不正アクセス、権利侵害、なりすまし、虚偽情報の送信、運営妨害、差別・脅迫・誹謗中傷、過度な負荷を与える行為、法令または公序良俗に反する行為を禁止します。カスタマーハラスメント対応方針の対象行為も含みます。',
      ],
      [
        '知的財産権',
        '本サイトの文章、デザイン、プログラム、ロゴ等の権利は、各権利者に帰属します。引用、転載、二次利用は法令および個別に示す条件に従ってください。第三者の商標・サービス名は各権利者に帰属します。',
      ],
      [
        '外部サービス・リンク',
        'X、Instagram、GitHub、ivRmその他の外部サイト・サービスは各運営者が提供します。外部サービスの内容、可用性、セキュリティ、データ取扱いについて、本サイトは保証しません。',
      ],
      [
        'サービス変更・停止',
        '保守、障害、安全確保、運営上の判断等により、事前の通知なく内容の変更、公開停止、機能制限を行う場合があります。可能な範囲で重要な変更を本サイト上に案内します。',
      ],
      [
        '免責・責任制限',
        '掲載情報の正確性と安全性の確保に努めますが、利用によって生じた損害を常に補償するものではありません。故意または重大な過失がある場合、法令上制限できない場合を除きます。',
      ],
      [
        '変更・準拠法',
        '本規約を改定する場合は、施行日と変更内容を本サイトで案内します。準拠法は日本法とし、紛争が生じた場合の管轄は公開前に法務確認を行い確定します。',
      ],
    ],
  },
  en: {
    privacy: [
      ['Principles', 'ivuru manages information used by this site and related services only to the extent necessary. Items still in draft, including the final inquiry channel, will be updated before launch.'],
      ['Information collected', 'Technical access information and local storage for theme, language, intro state, and external-social consent may be used. Contact details may be collected when the inquiry feature launches. Discord or Minecraft linkage data will be disclosed before collection.'],
      ['Purposes', 'Information may be used for site operation, preference storage, support, verification, abuse prevention, community operation, quality improvement, and incident investigation.'],
      ['External social media', 'X and Instagram scripts load only after the visitor requests the embed. Their providers may receive IP address, browser data, cookies, and related information. Cloudflare, GitHub, and other providers apply their own terms and privacy policies.'],
      ['Cookies and local storage', 'Theme, language, intro state, and external-media choices are stored on the device. They can be removed in browser settings. Analytics providers and opt-out methods will be disclosed when enabled.'],
      ['Third parties and international services', 'Information is not shared outside its purpose unless required by law, needed for safety, or consented to. Cloud and social services operated outside Japan may be used.'],
      ['Retention and security', 'Information is retained only as necessary and then deleted or anonymized. Access, logs, backups, and credentials are managed with reasonable safeguards.'],
      ['Requests', 'Procedures for access, correction, deletion, or suspension will be published with the Contact feature. Identity verification or legal and safety constraints may apply.'],
    ],
    terms: [
      ['Scope', 'These terms apply to the ivuru official site and related functions introduced by it. Separate ivRm, Discord, or Minecraft rules take priority where applicable.'],
      ['Prohibited conduct', 'Unauthorized access, infringement, impersonation, false submissions, disruption, discrimination, threats, defamation, excessive load, illegal conduct, and behavior covered by the abusive conduct policy are prohibited.'],
      ['Intellectual property', 'Text, design, software, logos, and other content belong to their respective owners. Quotation and reuse must follow law and any stated conditions.'],
      ['External services', 'X, Instagram, GitHub, ivRm, and other external services are operated by their providers. Their content, availability, security, and data handling are not guaranteed by this site.'],
      ['Changes and suspension', 'Content or functions may be changed, limited, or suspended for maintenance, incidents, safety, or operational reasons. Material changes will be announced where reasonably possible.'],
      ['Disclaimer', 'Reasonable efforts are made for accuracy and safety, but this does not guarantee compensation for every loss, except where liability cannot be limited by law.'],
      ['Changes and law', 'Changes will be announced with an effective date. Japanese law applies; jurisdiction will be finalized after legal review before launch.'],
    ],
  },
  ko: {
    privacy: [
      ['기본 방침', 'ivuru는 사이트와 관련 서비스 운영에 필요한 범위에서 정보를 관리합니다. 문의 접수 방법 등 미확정 항목은 공개 전에 갱신합니다.'],
      ['수집 정보', '접속 기술 정보와 테마, 언어, 인트로 상태, 외부 SNS 표시 동의를 위한 로컬 저장소를 사용할 수 있습니다. 문의 기능 공개 시 연락처와 문의 내용을 수집할 수 있습니다. Discord·Minecraft 연동 정보는 수집 전에 안내합니다.'],
      ['이용 목적', '사이트 표시, 설정 유지, 문의 대응, 본인 확인, 부정 이용 방지, 커뮤니티 운영, 품질 개선, 장애 조사에 이용합니다.'],
      ['외부 SNS', 'X와 Instagram 임베드는 사용자가 표시를 선택한 뒤에만 불러옵니다. 이때 IP 주소, 브라우저 정보, Cookie 등이 각 사업자에게 전송될 수 있습니다.'],
      ['Cookie 및 로컬 저장소', '테마, 언어, 인트로, 외부 미디어 선택을 기기에 저장합니다. 브라우저 설정에서 삭제할 수 있습니다. 분석 도구 도입 시 사업자와 거부 방법을 안내합니다.'],
      ['제3자 제공 및 해외 서비스', '법령, 안전 확보 또는 동의가 있는 경우를 제외하고 목적 외로 제공하지 않습니다. 해외 사업자가 운영하는 클라우드와 SNS를 이용할 수 있습니다.'],
      ['보관 및 보안', '필요한 기간만 보관하고 이후 삭제 또는 익명화합니다. 접근 권한, 로그, 백업, 인증 정보를 적절히 관리합니다.'],
      ['권리 요청', '열람, 정정, 삭제, 이용 정지 절차는 Contact 기능 공개 시 안내합니다. 본인 확인과 법령·안전상 제한이 적용될 수 있습니다.'],
    ],
    terms: [
      ['적용 범위', '본 약관은 ivuru 공식 사이트와 여기서 안내하는 관련 기능에 적용됩니다. ivRm, Discord, Minecraft의 별도 규정이 있는 경우 해당 문서가 우선합니다.'],
      ['금지 행위', '무단 접근, 권리 침해, 사칭, 허위 전송, 운영 방해, 차별, 협박, 비방, 과도한 부하, 불법 행위 및 고객 괴롭힘 대응 방침 대상 행위를 금지합니다.'],
      ['지식재산권', '문장, 디자인, 프로그램, 로고 등의 권리는 각 권리자에게 귀속됩니다. 인용과 재사용은 법령 및 별도 조건을 따라야 합니다.'],
      ['외부 서비스', 'X, Instagram, GitHub, ivRm 등은 각 사업자가 제공합니다. 외부 서비스의 내용, 가용성, 보안, 데이터 처리를 본 사이트가 보증하지 않습니다.'],
      ['변경 및 중단', '점검, 장애, 안전, 운영상 이유로 내용과 기능을 변경·제한·중단할 수 있습니다. 중요한 변경은 가능한 범위에서 안내합니다.'],
      ['면책', '정확성과 안전을 위해 노력하지만 모든 손해를 보상하는 것은 아닙니다. 법령상 제한할 수 없는 책임은 제외합니다.'],
      ['변경 및 준거법', '개정 시 시행일과 내용을 안내합니다. 일본법을 준거법으로 하며 관할은 공개 전 법률 검토 후 확정합니다.'],
    ],
  },
} as const;
const copy = legalCopy[locale][kind];
const chapter = kind === 'privacy'
  ? { code: '91', title: 'PRIVACY FILE', world: 'LEGAL ARCHIVE' }
  : { code: '92', title: 'TERMS FILE', world: 'LEGAL ARCHIVE' };
---

<BaseLayout
  title={`${title} — ${siteConfig.name} / ${siteConfig.idName}`}
  description={d.legal.note}
  locale={locale}
  chapter={chapter}
>
  <header class="page-hero legal-hero page-grid-bg" data-page-intro>
    <div class="page-hero-inner">
      <p class="eyebrow">LEGAL DOCUMENT / {chapter.code}</p><h1 class="page-title">{title}</h1><p>
        {d.legal.note}
      </p><span>{d.common.updated}: 2026-07-13 / DRAFT</span>
    </div>
  </header>
  <article class="legal-layout section" data-world-zone="legal">
    <nav aria-label={d.blog.toc}>
      <p>{d.blog.toc}</p>{
        copy.map(([heading], index) => (
          <a href={`#section-${index + 1}`}>
            {String(index + 1).padStart(2, '0')} / {heading}
          </a>
        ))
      }
    </nav><div class="legal-body">
      {
        copy.map(([heading, body], index) => (
          <section id={`section-${index + 1}`}>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <h2>{heading}</h2>
            <p>{body}</p>
          </section>
        ))
      }
    </div>
  </article>
</BaseLayout>
