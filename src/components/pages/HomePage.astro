---
import BaseLayout from '@/layouts/BaseLayout.astro';
import IdentitySection from '@/components/home/IdentitySection.astro';
import FeaturedWorks from '@/components/home/FeaturedWorks.astro';
import CommunitySection from '@/components/home/CommunitySection.astro';
import ActivitySection from '@/components/home/ActivitySection.astro';
import ActivityCommandCenter from '@/components/home/ActivityCommandCenter.astro';
import WorldPortalSection from '@/components/home/WorldPortalSection.astro';
import MediaReel from '@/components/home/MediaReel';
import LatestPosts from '@/components/blog/LatestPosts.astro';
import ContactCTA from '@/components/home/ContactCTA.astro';
import SocialDock from '@/components/social/SocialDock.astro';
import { localePath, siteConfig, type Locale } from '@/data/site-config';
import { getDictionary } from '@/i18n/dictionaries';

const { locale } = Astro.props as { locale: Locale };
const d = getDictionary(locale);
const descriptions = {
  ja: 'DeveloperとGamer、2つの世界を青と白のアニメエンタメ表現でつなぐ「いゔる。」の公式サイト。',
  en: 'The official ivuru site connecting Developer and Gamer worlds through a blue-and-white anime entertainment experience.',
  ko: 'Developer와 Gamer의 두 세계를 파랑과 흰색의 애니메이션 엔터테인먼트 경험으로 연결하는 ivuru 공식 사이트입니다.',
};
const heroCopy = {
  ja: {
    index: 'IVURU / BLUE MEDIA UNIVERSE',
    role: 'つくる。遊ぶ。つながる。好きな世界を、もっと鮮やかに。',
    body: 'Web開発、ゲーム、クラウド、ivRmコミュニティの記録を、青と白のアニメ作品のような一つのメディア体験にまとめています。',
    caption: 'ORIGINAL CHARACTER / BLUE SIGNAL',
    scroll: 'SCROLL TO THE NEXT SIGNAL',
  },
  en: {
    index: 'IVURU / BLUE MEDIA UNIVERSE',
    role: 'Build. Play. Connect. Make every world more vivid.',
    body: 'Web development, games, cloud work, and the ivRm community are connected as one blue-and-white anime media experience.',
    caption: 'ORIGINAL CHARACTER / BLUE SIGNAL',
    scroll: 'SCROLL TO THE NEXT SIGNAL',
  },
  ko: {
    index: 'IVURU / BLUE MEDIA UNIVERSE',
    role: '만들고, 즐기고, 이어지며 좋아하는 세계를 더 선명하게.',
    body: '웹 개발, 게임, 클라우드, ivRm 커뮤니티의 기록을 파랑과 흰색의 애니메이션 미디어 경험으로 연결합니다.',
    caption: 'ORIGINAL CHARACTER / BLUE SIGNAL',
    scroll: 'SCROLL TO THE NEXT SIGNAL',
  },
}[locale];
---

<BaseLayout
  title={siteConfig.title}
  description={descriptions[locale]}
  locale={locale}
  chapter={{ code: '00', title: 'HOME', world: 'BLUE MEDIA' }}
>
  <section class="blue-media-hero" data-hero data-page-intro data-anime-scene="ice" data-anime-hero>
    <span class="blue-hero-slash is-top" data-anime-parallax="-5" aria-hidden="true"></span>
    <span class="blue-hero-slash is-bottom" data-anime-parallax="4" aria-hidden="true"></span>
    <span class="blue-hero-orbit" data-blue-orbit aria-hidden="true"></span>
    <svg
      class="blue-hero-path"
      viewBox="0 0 1600 320"
      preserveAspectRatio="none"
      aria-hidden="true"
    >
      <path data-blue-path d="M-40 286C248 44 514 365 780 135S1278 46 1640 224"></path>
    </svg>

    <div class="blue-media-hero-inner">
      <div class="blue-media-copy" data-hero-copy data-blue-reveal>
        <p class="blue-media-index">{heroCopy.index}</p>
        <h1 class="blue-media-title" data-blue-split>
          <span>いゔる。</span><span>ivuru / Developer · Gamer · Community</span>
        </h1>
        <p class="blue-media-lede">
          <strong>{heroCopy.role}</strong><br />{heroCopy.body}
        </p>
        <div class="blue-media-actions" data-anime-stagger>
          <a href={localePath(locale, '/works')}>{d.hero.works}</a>
          <a href={localePath(locale, '/profile')}>{d.hero.profile}</a>
          <a href={siteConfig.xUrl} target="_blank" rel="noopener noreferrer">X ↗</a>
        </div>
        <div class="blue-media-meta" role="group" aria-label="Site topics" data-anime-stagger>
          <span>WEB DEVELOPMENT</span><span>GAME</span><span>COMMUNITY</span>
        </div>
      </div>

      <figure
        class="blue-media-character"
        data-anime-visual
        data-blue-visual
        data-anime-parallax="-3"
      >
        <img
          src="/assets/visuals/blue-anime/ivuru-hero-blue.svg"
          alt=""
          width="1600"
          height="1200"
          loading="eager"
          fetchpriority="high"
        />
        <figcaption>{heroCopy.caption}</figcaption>
      </figure>
    </div>
    <div class="blue-media-scroll-note" aria-hidden="true"><i></i>{heroCopy.scroll}</div>
  </section>

  <div class="anime-scene-anchor" data-anime-scene="sky">
    <ActivityCommandCenter locale={locale} />
  </div>
  <div class="anime-scene-anchor" data-anime-scene="deep">
    <WorldPortalSection locale={locale} />
  </div>
  <div class="anime-scene-anchor" data-anime-scene="ice">
    <IdentitySection locale={locale} />
    <FeaturedWorks locale={locale} />
  </div>
  <div class="anime-scene-anchor" data-anime-scene="sky">
    <CommunitySection locale={locale} />
    <ActivitySection locale={locale} />
  </div>
  <section class="media-section section" data-world-zone="creative" data-anime-scene="deep">
    <div class="section-heading section-inner" data-reveal>
      <div><p class="section-kicker">VISUAL LOG</p><h2>{d.sections.media}</h2></div>
      <p class="section-intro">Development / Gaming / Community / Creative</p>
    </div>
    <MediaReel client:visible />
  </section>
  <SocialDock locale={locale} />
  <LatestPosts locale={locale} />
  <ContactCTA locale={locale} />
</BaseLayout>

<style>
  .anime-scene-anchor {
    position: relative;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.world-loader) {
      pointer-events: none !important;
    }
  }
</style>
