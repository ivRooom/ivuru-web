---
import BaseLayout from '@/layouts/BaseLayout.astro';
import AnimeScrollStory from '@/components/home/AnimeScrollStory.astro';
import IdentitySection from '@/components/home/IdentitySection.astro';
import FeaturedWorks from '@/components/home/FeaturedWorks.astro';
import CommunitySection from '@/components/home/CommunitySection.astro';
import ActivitySection from '@/components/home/ActivitySection.astro';
import ActivityCommandCenter from '@/components/home/ActivityCommandCenter.astro';
import SignalLinksSection from '@/components/home/SignalLinksSection.astro';
import MediaReel from '@/components/home/MediaReel';
import LatestPosts from '@/components/blog/LatestPosts.astro';
import ContactCTA from '@/components/home/ContactCTA.astro';
import SocialDock from '@/components/social/SocialDock.astro';
import CinematicPointerEffects from '@/components/effects/CinematicPointerEffects';
import AnimeScrollDirector from '@/components/effects/AnimeScrollDirector';
import { siteConfig, type Locale } from '@/data/site-config';
import { getDictionary } from '@/i18n/dictionaries';
import '@/styles/anime-scroll-story.css';
import '@/styles/anime-scroll-story-overrides.css';
import '@/styles/anime-scroll-performance.css';
import '@/styles/signal-links.css';

const { locale } = Astro.props as { locale: Locale };
const d = getDictionary(locale);
const descriptions = {
  ja: 'Developer、Gamer、Communityの世界を、スクロールで展開する青と白のアニメ作品として体験できる「いゔる。」の公式サイト。',
  en: 'The official ivuru site, presented as a blue-and-white anime scroll story connecting Developer, Gamer, and Community worlds.',
  ko: 'Developer, Gamer, Community의 세계를 스크롤로 펼쳐지는 파랑과 흰색 애니메이션 스토리로 경험하는 ivuru 공식 사이트입니다.',
};
---

<BaseLayout
  title={siteConfig.title}
  description={descriptions[locale]}
  locale={locale}
  chapter={{ code: '00', title: 'HOME', world: 'BLUE STORY' }}
>
  <CinematicPointerEffects client:idle />
  <AnimeScrollDirector client:idle />

  <AnimeScrollStory locale={locale} />

  <div class="anime-story-after">
    <div class="anime-scene-anchor" data-anime-scene="ice" data-cinematic-section>
      <IdentitySection locale={locale} />
      <FeaturedWorks locale={locale} />
    </div>

    <div class="anime-scene-anchor" data-anime-scene="sky" data-cinematic-section>
      <ActivityCommandCenter locale={locale} />
      <CommunitySection locale={locale} />
      <ActivitySection locale={locale} />
    </div>

    <SignalLinksSection locale={locale} />

    <section
      class="media-section section"
      data-world-zone="creative"
      data-anime-scene="deep"
      data-cinematic-section
    >
      <div class="section-heading section-inner" data-reveal>
        <div><p class="section-kicker">VISUAL LOG</p><h2>{d.sections.media}</h2></div>
        <p class="section-intro">Development / Gaming / Community / Creative</p>
      </div>
      <MediaReel client:visible />
    </section>

    <SocialDock locale={locale} />
    <LatestPosts locale={locale} />
    <ContactCTA locale={locale} />
  </div>
</BaseLayout>

<style>
  .anime-scene-anchor {
    position: relative;
  }

  :global(.anime-scroll-story .anime-portal-card) {
    translate: none;
    rotate: none;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.world-loader) {
      pointer-events: none !important;
    }
  }
</style>
