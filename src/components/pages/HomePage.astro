---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroWorld from '@/components/home/HeroWorld';
import ScrollEffects from '@/components/effects/ScrollEffects';
import IdentitySection from '@/components/home/IdentitySection.astro';
import FeaturedWorks from '@/components/home/FeaturedWorks.astro';
import CommunitySection from '@/components/home/CommunitySection.astro';
import ActivitySection from '@/components/home/ActivitySection.astro';
import ActivityCommandCenter from '@/components/home/ActivityCommandCenter.astro';
import WorldPortalSection from '@/components/home/WorldPortalSection.astro';
import MediaReel from '@/components/home/MediaReel';
import LatestPosts from '@/components/blog/LatestPosts.astro';
import ContactCTA from '@/components/home/ContactCTA.astro';
import SocialDock from '@/components/social/SocialDock.astro';
import { localePath, siteConfig, type Locale } from '@/data/site-config';
import { getDictionary } from '@/i18n/dictionaries';
import '@/styles/home-editorial.css';

const { locale } = Astro.props as { locale: Locale };
const d = getDictionary(locale);
const descriptions = {
  ja: 'DeveloperとGamer、2つの世界をつなぐ「いゔる。」の公式サイト。個人開発、ゲーム、ivRmコミュニティ、創作活動を発信します。',
  en: 'The official site of ivuru, connecting Developer and Gamer worlds through projects, games, the ivRm community, and creative work.',
  ko: 'Developer와 Gamer의 두 세계를 연결하는 ivuru 공식 사이트입니다. 개인 개발, 게임, ivRm 커뮤니티, 창작 활동을 소개합니다.',
};
const heroCopy = {
  ja: {
    kicker: 'IVURU / PERSONAL WEBSITE',
    role: 'Webをつくり、ゲームで遊び、コミュニティを育てる。',
    body: '個人開発、クラウド、ゲーム、ivRmコミュニティの記録を、過度な演出に頼らず一つの場所へまとめています。',
    caption: 'workspace sketch / developer · gamer · community',
  },
  en: {
    kicker: 'IVURU / PERSONAL WEBSITE',
    role: 'Building for the web, playing games, and growing communities.',
    body: 'A calm record of personal development, cloud work, games, and the ivRm community without unnecessary visual effects.',
    caption: 'workspace sketch / developer · gamer · community',
  },
  ko: {
    kicker: 'IVURU / PERSONAL WEBSITE',
    role: '웹을 만들고, 게임을 즐기고, 커뮤니티를 키웁니다.',
    body: '개인 개발, 클라우드, 게임, ivRm 커뮤니티의 기록을 과한 연출 없이 한곳에 정리합니다.',
    caption: 'workspace sketch / developer · gamer · community',
  },
}[locale];
---

<BaseLayout
  title={siteConfig.title}
  description={descriptions[locale]}
  locale={locale}
  chapter={{ code: '00', title: 'HOME', world: 'IVURU' }}
>
  <section class="home-editorial-hero" data-hero data-page-intro data-editorial-hero>
    <HeroWorld locale={locale} client:only="react" />
    <div class="home-editorial-hero-inner">
      <div class="home-editorial-copy" data-hero-copy>
        <p class="eyebrow">{heroCopy.kicker}</p>
        <h1 class="home-editorial-title">いゔる。<span>ivuru / Developer · Gamer</span></h1>
        <p class="home-editorial-role"><strong>{heroCopy.role}</strong><br />{heroCopy.body}</p>
        <div class="home-editorial-actions">
          <a href={localePath(locale, '/works')}>{d.hero.works}</a>
          <a href={localePath(locale, '/profile')}>{d.hero.profile}</a>
          <a href={siteConfig.xUrl} target="_blank" rel="noopener noreferrer">X ↗</a>
        </div>
        <div class="home-editorial-meta" aria-label="Site topics">
          <span>WEB DEVELOPMENT</span><span>GAME</span><span>COMMUNITY</span>
        </div>
      </div>
      <figure class="home-editorial-sketch">
        <img
          src="/assets/visuals/editorial/home-studio-sketch.svg"
          alt=""
          width="1200"
          height="800"
          loading="eager"
        />
        <figcaption>{heroCopy.caption}</figcaption>
      </figure>
    </div>
  </section>

  <ActivityCommandCenter locale={locale} />
  <WorldPortalSection locale={locale} />
  <IdentitySection locale={locale} />
  <FeaturedWorks locale={locale} />
  <CommunitySection locale={locale} />
  <ActivitySection locale={locale} />
  <section class="media-section section" data-world-zone="creative">
    <div class="section-heading section-inner" data-reveal>
      <div><p class="section-kicker">VISUAL LOG</p><h2>{d.sections.media}</h2></div>
      <p class="section-intro">Development / Gaming / Community / Creative</p>
    </div>
    <MediaReel client:visible />
  </section>
  <SocialDock locale={locale} />
  <LatestPosts locale={locale} />
  <ContactCTA locale={locale} />
  <ScrollEffects client:idle />
</BaseLayout>

<style>
  @media (prefers-reduced-motion: reduce) {
    :global(.world-loader) {
      visibility: hidden !important;
      opacity: 0 !important;
      pointer-events: none !important;
    }
  }
</style>
