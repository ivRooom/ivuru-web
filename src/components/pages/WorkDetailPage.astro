---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { projects, type Project } from '@/data/projects';
import { localePath, siteConfig, type Locale } from '@/data/site-config';
import { getDictionary } from '@/i18n/dictionaries';
const { locale, project } = Astro.props as { locale: Locale; project: Project };
const d = getDictionary(locale);
const sectionKeys = [
  'overview',
  'background',
  'role',
  'technology',
  'features',
  'design',
  'challenges',
  'status',
  'gallery',
  'links',
] as const;
const index = projects.findIndex((item) => item.slug === project.slug);
const prev = projects[(index - 1 + projects.length) % projects.length];
const next = projects[(index + 1) % projects.length];
const placeholder = {
  ja: 'この項目は実際のプロジェクト情報を確認後に更新します。架空の成果・数値は掲載していません。',
  en: 'This section will be updated after the real project details are confirmed. No fictional outcomes or metrics are presented.',
  ko: '실제 프로젝트 정보를 확인한 후 업데이트합니다. 허구의 성과나 수치는 게시하지 않습니다.',
}[locale];
const copy = {
  ja: { back: 'ワールド選択へ戻る', briefing: 'MISSION BRIEFING', route: 'ROUTE STATUS', available: 'AVAILABLE' },
  en: { back: 'Back to world select', briefing: 'MISSION BRIEFING', route: 'ROUTE STATUS', available: 'AVAILABLE' },
  ko: { back: '월드 선택으로', briefing: 'MISSION BRIEFING', route: 'ROUTE STATUS', available: 'AVAILABLE' },
}[locale];
---

<BaseLayout
  title={`${project.title} — ${siteConfig.name} / ${siteConfig.idName} Works`}
  description={project.description[locale]}
  locale={locale}
  chapter={{ code: `02-${String(index + 1).padStart(2, '0')}`, title: project.title.toUpperCase(), world: 'MISSION ROUTE' }}
>
  <header class={`work-detail-hero mission-briefing-hero accent-${project.accent}`} data-page-intro>
    <div class="mission-briefing-copy">
      <a href={localePath(locale, '/works')}>← {copy.back}</a>
      <p class="eyebrow">{copy.briefing} / {String(index + 1).padStart(2, '0')}</p>
      <h1 transition:name={`work-title-${project.slug}`}>{project.title}</h1>
      <p>{project.description[locale]}</p>
      <div class="project-tech">{project.technologies.map((tech) => <span class="chip">{tech}</span>)}</div>
      <dl class="mission-metadata">
        <div><dt>CATEGORY</dt><dd>{project.category}</dd></div>
        <div><dt>STATUS</dt><dd>{project.status}</dd></div>
        <div><dt>YEAR</dt><dd>{project.year}</dd></div>
        <div><dt>{copy.route}</dt><dd>{copy.available}</dd></div>
      </dl>
    </div>
    <div class="work-detail-orbit mission-detail-visual" transition:name={`work-cover-${project.slug}`} aria-hidden="true">
      <i></i><i></i><i></i><span>{String(index + 1).padStart(2, '0')}</span>
    </div>
  </header>

  <article class="work-detail mission-document section" data-world-zone="mission">
    <div class="work-toc mission-toc">
      <span>MISSION INDEX</span>
      {sectionKeys.map((key, sectionIndex) => <a href={`#${key}`}>{String(sectionIndex + 1).padStart(2, '0')} / {d.works[key]}</a>)}
    </div>
    <div class="work-content mission-content">
      {sectionKeys.map((key, sectionIndex) => (
        <section id={key} data-reveal>
          <small>SECTION / {String(sectionIndex + 1).padStart(2, '0')}</small>
          <h2>{d.works[key]}</h2>
          {key === 'overview' ? (
            <p>{project.description[locale]}</p>
          ) : key === 'technology' ? (
            <div class="project-tech">{project.technologies.map((tech) => <span class="chip">{tech}</span>)}</div>
          ) : key === 'status' ? (
            <p>{project.status}</p>
          ) : key === 'links' && project.externalUrl ? (
            <a class="text-link" href={project.externalUrl} target="_blank" rel="noopener noreferrer">External site ↗</a>
          ) : (
            <p>{placeholder}</p>
          )}
        </section>
      ))}
    </div>
  </article>

  <nav class="work-navigation mission-navigation" aria-label="Project navigation">
    <a href={localePath(locale, `/works/${prev.slug}`)}><small>PREVIOUS MISSION</small><span>← {prev.title}</span></a>
    <a href={localePath(locale, `/works/${next.slug}`)}><small>NEXT MISSION</small><span>{next.title} →</span></a>
  </nav>
</BaseLayout>
