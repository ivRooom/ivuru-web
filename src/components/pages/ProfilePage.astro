---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { profile } from '@/data/profile';
import { gameClips } from '@/data/game-clips';
import { socialLinks } from '@/data/social-links';
import { localePath, siteConfig, type Locale } from '@/data/site-config';
import { getDictionary } from '@/i18n/dictionaries';

const { locale } = Astro.props as { locale: Locale };
const d = getDictionary(locale);
const about = {
  ja: 'Web開発を軸に、ゲーム、クラウド、コミュニティ運営を横断して活動しています。DeveloperとGamer、そしてivRmオーナーという複数の世界をつなぎ、体験そのものを設計しています。',
  en: 'Working across web development, gaming, cloud, and community operations—connecting the worlds of Developer, Gamer, and ivRm owner through designed experiences.',
  ko: '웹 개발을 중심으로 게임, 클라우드, 커뮤니티 운영을 넘나들며 Developer, Gamer, ivRm 오너의 세계를 하나의 경험으로 연결합니다.',
}[locale];
const copy = {
  ja: {
    social: '通信ノード',
    socialIntro:
      '活動・配信・コミュニティ・連絡先へ接続します。公開URLが設定されているノードだけを表示します。',
    clips: 'ゲームリプレイ・アーカイブ',
    clipsIntro: 'ゲームクリップ、配信切り抜き、ショート動画を記録する領域です。',
    clipsEmpty:
      '公開できるクリップを準備中です。YouTube・Twitch・TikTok・Xの実URLを追加すると表示されます。',
    passport: 'WORLD PASSPORT',
    access: 'ACCESS LEVEL / CREATOR',
    identities: 'CONNECTED IDENTITIES / 03',
    nowBuilding: 'NOW BUILDING',
    nowPlaying: 'NOW PLAYING',
    nowListening: 'NOW LISTENING',
  },
  en: {
    social: 'Communication Nodes',
    socialIntro:
      'Connect to activity, streams, community, and contact routes. Only configured nodes are shown.',
    clips: 'Game Replay Archive',
    clipsIntro: 'A place for game clips, stream highlights, and short-form video.',
    clipsEmpty:
      'Public clips are being prepared. Cards appear after real YouTube, Twitch, TikTok, or X URLs are added.',
    passport: 'WORLD PASSPORT',
    access: 'ACCESS LEVEL / CREATOR',
    identities: 'CONNECTED IDENTITIES / 03',
    nowBuilding: 'NOW BUILDING',
    nowPlaying: 'NOW PLAYING',
    nowListening: 'NOW LISTENING',
  },
  ko: {
    social: '통신 노드',
    socialIntro: '활동, 방송, 커뮤니티, 연락처로 연결합니다. 설정된 노드만 표시합니다.',
    clips: '게임 리플레이 아카이브',
    clipsIntro: '게임 클립, 방송 하이라이트, 숏폼 영상을 기록하는 영역입니다.',
    clipsEmpty:
      '공개 가능한 클립을 준비 중입니다. 실제 YouTube, Twitch, TikTok, X URL을 추가하면 표시됩니다.',
    passport: 'WORLD PASSPORT',
    access: 'ACCESS LEVEL / CREATOR',
    identities: 'CONNECTED IDENTITIES / 03',
    nowBuilding: 'NOW BUILDING',
    nowPlaying: 'NOW PLAYING',
    nowListening: 'NOW LISTENING',
  },
}[locale];
---

<BaseLayout
  title={`${d.profile.title} — ${siteConfig.name} / ${siteConfig.idName}`}
  description={d.profile.intro}
  locale={locale}
  chapter={{ code: '01', title: 'CHARACTER PROFILE', world: 'DEVELOPER WORLD' }}
>
  <header class="page-hero profile-hero character-world page-grid-bg" data-page-intro>
    <div class="page-hero-inner">
      <p class="eyebrow">CHARACTER FILE / 001</p>
      <h1 class="page-title">{d.profile.title}</h1>
      <p>{d.profile.intro}</p>
      <div class="character-scan" aria-hidden="true">
        <i></i><span>ID / {profile.id.toUpperCase()}</span>
      </div>
    </div>
  </header>

  <section class="profile-character-screen section" data-world-zone="identity">
    <div class="section-inner character-sheet profile-passport" data-reveal>
      <header class="character-sheet-bar">
        <span>IDENTITY DATABASE</span>
        <span class="character-online"><i></i>ONLINE</span>
        <span>FILE NO. 001</span>
      </header>

      <div class="character-portrait profile-avatar-stage">
        <div class="character-portrait-frame profile-avatar-frame">
          <img
            src={siteConfig.profileImageUrl}
            alt={`${siteConfig.name} / ${siteConfig.idName} profile icon from X`}
            width="720"
            height="720"
            loading="eager"
            referrerpolicy="no-referrer"
          />
          <div class="character-reticle" aria-hidden="true"><i></i><i></i><i></i></div>
          <div class="avatar-orbit" aria-hidden="true"><i></i><i></i><i></i></div>
          <span class="avatar-source">SOURCE / X {siteConfig.xHandle}</span>
        </div>
        <div class="character-portrait-data">
          <span>CALLSIGN</span><strong>{profile.id}</strong><small>World Gate synchronized</small>
        </div>
      </div>

      <div class="character-data">
        <p class="section-kicker">{copy.passport}</p>
        <div class="character-name-line">
          <h2>{profile.name}</h2><span>{profile.id.toUpperCase()}</span>
        </div>
        <p class="character-about">{about}</p>
        <div class="passport-status-grid">
          <span>{copy.access}</span><span>{copy.identities}</span><span>STATUS / ONLINE</span>
        </div>
        <dl class="character-core-stats">
          <div><dt>PRIMARY</dt><dd>Developer</dd></div>
          <div><dt>SECONDARY</dt><dd>Gamer / Creator</dd></div>
          <div><dt>ROLE</dt><dd>ivRm Owner / Community Operator</dd></div>
          <div><dt>MODE</dt><dd>BUILD. PLAY. CREATE.</dd></div>
        </dl>
        <div class="identity-switch" aria-label="Identity modes">
          <span data-mode="developer">DEVELOPER MODE</span>
          <span data-mode="gamer">GAMER MODE</span>
          <span data-mode="community">COMMUNITY MODE</span>
        </div>
        <div class="character-interests">
          {profile.interests.map((interest) => <span>{interest}</span>)}
        </div>
      </div>
    </div>
  </section>

  <section class="profile-now-grid section" data-world-zone="signal">
    <div class="section-inner now-panels">
      <article data-reveal>
        <small>{copy.nowBuilding}</small><strong>ivuru Official World</strong><p>
          Astro / React / Cloudflare
        </p>
      </article>
      <article data-reveal>
        <small>{copy.nowPlaying}</small><strong>Gamer World</strong><p>
          Clips / Streams / Community Sessions
        </p>
      </article>
      <article data-reveal>
        <small>{copy.nowListening}</small><strong>Favorite Sound World</strong><p>
          Music / Pages / Personal Archive
        </p><a href={localePath(locale, '/favorites')}>OPEN FAVORITES ↗</a>
      </article>
    </div>
  </section>

  <section class="social-hub section" data-world-zone="signal">
    <div class="section-inner">
      <div class="section-heading" data-reveal>
        <div><p class="section-kicker">SOCIAL SIGNAL MATRIX</p><h2>{copy.social}</h2></div>
        <p class="section-intro">{copy.socialIntro}</p>
      </div>
      <div class="social-node-grid">
        {
          socialLinks.map((item, index) => (
            <a
              class={`social-node social-${item.accent}`}
              href={item.href}
              target={item.key === 'email' ? undefined : '_blank'}
              rel={item.key === 'email' ? undefined : 'noopener noreferrer'}
              data-reveal
            >
              <small>NODE / {String(index + 1).padStart(2, '0')}</small>
              <strong>{item.label}</strong>
              <span>{item.description}</span>
              <i aria-hidden="true">↗</i>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="game-clip-archive section" data-world-zone="gamer">
    <div class="section-inner">
      <div class="section-heading" data-reveal>
        <div><p class="section-kicker">REPLAY STORAGE</p><h2>{copy.clips}</h2></div>
        <p class="section-intro">{copy.clipsIntro}</p>
      </div>
      {
        gameClips.length > 0 ? (
          <div class="clip-grid">
            {gameClips.map((clip, index) => (
              <a
                class="clip-card"
                href={clip.url}
                target="_blank"
                rel="noopener noreferrer"
                data-reveal
              >
                <div class="clip-visual">
                  {clip.thumbnail ? (
                    <img src={clip.thumbnail} alt="" loading="lazy" />
                  ) : (
                    <span>REPLAY / {String(index + 1).padStart(2, '0')}</span>
                  )}
                  <b>{clip.duration ?? 'CLIP'}</b>
                </div>
                <small>
                  {clip.platform.toUpperCase()} / {clip.game}
                </small>
                <h3>{clip.title}</h3>
                <div>
                  {clip.tags?.map((tag) => (
                    <span>#{tag}</span>
                  ))}
                </div>
              </a>
            ))}
          </div>
        ) : (
          <div class="clip-empty" data-reveal>
            <>
              <span>NO REPLAY DATA</span>
              <p>{copy.clipsEmpty}</p>
            </>
          </div>
        )
      }
    </div>
  </section>

  <section class="profile-stack character-capabilities section" data-world-zone="developer">
    <div class="section-inner">
      <div class="section-heading" data-reveal>
        <div><p class="section-kicker">CAPABILITY MODULES</p><h2>{d.profile.stack}</h2></div>
      </div>
      <div class="stack-groups character-module-grid">
        {
          Object.entries(profile.stack).map(([group, items], groupIndex) => (
            <article data-reveal>
              <header>
                <>
                  <small>MODULE / {String(groupIndex + 1).padStart(2, '0')}</small>
                  <h3>{group}</h3>
                </>
              </header>
              <ul>
                {items.map((item) => (
                  <li>
                    <span>{item.name}</span>
                    <small data-status={item.status}>{d.profile.statuses[item.status]}</small>
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="timeline character-history section" data-world-zone="night">
    <div class="section-inner">
      <div class="section-heading" data-reveal>
        <div>
          <p class="section-kicker">CHARACTER LOG / NOW → NEXT</p><h2>{d.profile.timeline}</h2>
        </div>
      </div>
      <div class="timeline-list">
        {
          profile.timeline.map((item, index) => (
            <article data-reveal>
              <>
                <span>{item.year}</span>
                <i />
                <p>{d.profile.timelineItems[item.key]}</p>
                <small>LOG-{String(index + 1).padStart(2, '0')}</small>
              </>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
