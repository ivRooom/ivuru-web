---
import BaseLayout from '@/layouts/BaseLayout.astro';
import DeferredSpotify from '@/components/common/DeferredSpotify';
import { profile } from '@/data/profile';
import { favoriteLinks, spotifyEmbedUrl } from '@/data/favorites';
import { gameClips } from '@/data/game-clips';
import { socialLinks } from '@/data/social-links';
import { siteConfig, type Locale } from '@/data/site-config';
import { getDictionary } from '@/i18n/dictionaries';
import '@/styles/editorial-refresh.css';

const { locale } = Astro.props as { locale: Locale };
const d = getDictionary(locale);
const about = {
  ja: 'Web開発を軸に、ゲーム、クラウド、コミュニティ運営を横断して活動しています。つくることと遊ぶことを分けず、長く使える体験としてまとめるのが好きです。',
  en: 'I work across web development, games, cloud infrastructure, and community operations. I like treating building and playing as parts of the same long-lived experience.',
  ko: '웹 개발을 중심으로 게임, 클라우드, 커뮤니티 운영을 넘나듭니다. 만들기와 플레이를 나누지 않고 오래 사용할 수 있는 경험으로 정리하는 것을 좋아합니다.',
}[locale];
const copy = {
  ja: {
    heroKicker: 'PROFILE / IVURU',
    heroSubtitle: 'Developer, gamer, and community operator',
    social: 'リンク',
    socialIntro: '活動、配信、コミュニティ、連絡先。現在公開している接続先だけをまとめています。',
    clips: 'ゲームクリップ',
    clipsIntro: 'ゲームクリップ、配信切り抜き、ショート動画の記録です。',
    clipsEmpty: '公開できるクリップを準備中です。',
    profileLabel: 'ABOUT / PROFILE',
    focus: 'FOCUS / WEB & GAME',
    identities: 'INTERESTS / DEVELOPMENT · GAME · COMMUNITY',
    nowBuilding: 'CURRENT PROJECT',
    nowPlaying: 'CURRENT INTEREST',
    nowListening: 'ON REPEAT',
    favoritesKicker: 'FAVORITES / PERSONAL SHELF',
    favoritesTitle: 'よく戻る場所と、気分を切り替える音楽。',
    favoritesIntro:
      'Favoritesは独立したページではなく、Profileの一部としてまとめました。制作、ゲーム、コミュニティ、音楽の入口を、過度な演出なしで並べています。',
    favoriteOpen: '開く',
    musicTitle: '作業とゲームのためのプレイリスト',
    musicBody:
      'Spotifyは操作するまで外部通信を開始しません。集中したい時間や、ゲームのあとに余韻を残したい時間に流す音楽です。',
    musicPalette: ['Future Bass', 'Lo-fi', 'Game Soundtrack', 'Anime Songs'],
    illustrationCaption: 'personal shelf / sketch 01',
    skills: 'スキル',
    timeline: 'これまでと、これから',
  },
  en: {
    heroKicker: 'PROFILE / IVURU',
    heroSubtitle: 'Developer, gamer, and community operator',
    social: 'Links',
    socialIntro: 'Public routes to activity, streams, community, and contact.',
    clips: 'Game clips',
    clipsIntro: 'A record of game clips, stream highlights, and short videos.',
    clipsEmpty: 'Public clips are being prepared.',
    profileLabel: 'ABOUT / PROFILE',
    focus: 'FOCUS / WEB & GAME',
    identities: 'INTERESTS / DEVELOPMENT · GAME · COMMUNITY',
    nowBuilding: 'CURRENT PROJECT',
    nowPlaying: 'CURRENT INTEREST',
    nowListening: 'ON REPEAT',
    favoritesKicker: 'FAVORITES / PERSONAL SHELF',
    favoritesTitle: 'Places I return to and music that changes the pace.',
    favoritesIntro:
      'Favorites now lives inside Profile instead of a separate page. The links are kept calm and direct, without unnecessary visual effects.',
    favoriteOpen: 'Open',
    musicTitle: 'A playlist for building and playing',
    musicBody:
      'Spotify does not connect until you choose to load it. This is music for focused work and the quiet time after a game.',
    musicPalette: ['Future Bass', 'Lo-fi', 'Game Soundtrack', 'Anime Songs'],
    illustrationCaption: 'personal shelf / sketch 01',
    skills: 'Skills',
    timeline: 'Past and next',
  },
  ko: {
    heroKicker: 'PROFILE / IVURU',
    heroSubtitle: 'Developer, gamer, and community operator',
    social: '링크',
    socialIntro: '활동, 방송, 커뮤니티, 연락처 중 현재 공개된 연결만 정리합니다.',
    clips: '게임 클립',
    clipsIntro: '게임 클립, 방송 하이라이트, 짧은 영상 기록입니다.',
    clipsEmpty: '공개할 수 있는 클립을 준비 중입니다.',
    profileLabel: 'ABOUT / PROFILE',
    focus: 'FOCUS / WEB & GAME',
    identities: 'INTERESTS / DEVELOPMENT · GAME · COMMUNITY',
    nowBuilding: 'CURRENT PROJECT',
    nowPlaying: 'CURRENT INTEREST',
    nowListening: 'ON REPEAT',
    favoritesKicker: 'FAVORITES / PERSONAL SHELF',
    favoritesTitle: '자주 돌아가는 장소와 분위기를 바꾸는 음악.',
    favoritesIntro:
      'Favorites를 별도 페이지가 아닌 Profile의 일부로 정리했습니다. 불필요한 효과 없이 제작, 게임, 커뮤니티, 음악의 입구를 보여줍니다.',
    favoriteOpen: '열기',
    musicTitle: '작업과 게임을 위한 플레이리스트',
    musicBody:
      'Spotify는 직접 불러오기 전까지 외부 통신을 시작하지 않습니다. 집중할 때와 게임이 끝난 뒤의 여운을 위한 음악입니다.',
    musicPalette: ['Future Bass', 'Lo-fi', 'Game Soundtrack', 'Anime Songs'],
    illustrationCaption: 'personal shelf / sketch 01',
    skills: '기술',
    timeline: '지금까지와 앞으로',
  },
}[locale];
---

<BaseLayout
  title={`${d.profile.title} — ${siteConfig.name} / ${siteConfig.idName}`}
  description={d.profile.intro}
  locale={locale}
  chapter={{ code: '01', title: 'PROFILE', world: 'IVURU' }}
>
  <header class="editorial-page-hero" data-page-intro>
    <div class="editorial-page-hero-inner">
      <div class="editorial-page-hero-copy">
        <p class="editorial-kicker">{copy.heroKicker}</p>
        <h1>{profile.name}<span>{copy.heroSubtitle}</span></h1>
        <p class="editorial-lede">{about}</p>
        <div class="editorial-hero-note" aria-label="Profile focus">
          <span>WEB DEVELOPMENT</span><span>GAME</span><span>COMMUNITY</span>
        </div>
      </div>
      <figure class="editorial-hero-illustration profile-editorial-avatar">
        <img
          src={siteConfig.profileImageUrl}
          alt={`${siteConfig.name} / ${siteConfig.idName}`}
          width="720"
          height="720"
          loading="eager"
          referrerpolicy="no-referrer"
        />
      </figure>
    </div>
  </header>

  <section class="profile-character-screen section" data-world-zone="identity">
    <div class="section-inner character-sheet profile-passport" data-reveal>
      <header class="character-sheet-bar">
        <span>PROFILE / IVURU</span>
        <span class="character-online"><i></i>ONLINE</span>
        <span>UPDATED / 2026</span>
      </header>

      <div class="character-portrait profile-avatar-stage">
        <div class="character-portrait-frame profile-avatar-frame">
          <img
            src={siteConfig.profileImageUrl}
            alt={`${siteConfig.name} / ${siteConfig.idName} original blue profile character`}
            width="720"
            height="720"
            loading="lazy"
          />
          <span class="avatar-source">{siteConfig.xHandle}</span>
        </div>
        <div class="character-portrait-data">
          <span>ID</span><strong>{profile.id}</strong><small>Developer / Gamer</small>
        </div>
      </div>

      <div class="character-data">
        <p class="section-kicker">{copy.profileLabel}</p>
        <div class="character-name-line">
          <h2>{profile.name}</h2><span>{profile.id.toUpperCase()}</span>
        </div>
        <p class="character-about">{about}</p>
        <div class="passport-status-grid">
          <span>{copy.focus}</span><span>{copy.identities}</span><span>STATUS / ACTIVE</span>
        </div>
        <dl class="character-core-stats">
          <div><dt>PRIMARY</dt><dd>Developer</dd></div>
          <div><dt>SECONDARY</dt><dd>Gamer / Creator</dd></div>
          <div><dt>ROLE</dt><dd>ivRm Owner / Community Operator</dd></div>
          <div><dt>THEME</dt><dd>BUILD. PLAY. CREATE.</dd></div>
        </dl>
        <div class="character-interests">
          {profile.interests.map((interest) => <span>{interest}</span>)}
        </div>
      </div>
    </div>
  </section>

  <section class="profile-now-grid section" data-world-zone="signal">
    <div class="section-inner now-panels">
      <article data-reveal>
        <small>{copy.nowBuilding}</small><strong>ivuru Official Website</strong><p>
          Astro / React / Cloudflare
        </p>
      </article>
      <article data-reveal>
        <small>{copy.nowPlaying}</small><strong>Games and community sessions</strong><p>
          Clips / Streams / Minecraft
        </p>
      </article>
      <article data-reveal>
        <small>{copy.nowListening}</small><strong>Personal playlist</strong><p>
          Focus / Game / Late night
        </p><a href="#favorites">FAVORITES ↓</a>
      </article>
    </div>
  </section>

  <section id="favorites" class="profile-favorites-editorial section" data-world-zone="creative">
    <div class="section-inner profile-favorites-layout">
      <figure class="profile-favorites-visual" data-reveal>
        <img
          src="/assets/visuals/editorial/favorites-desk-sketch.svg"
          alt=""
          width="1200"
          height="800"
          loading="lazy"
        />
        <figcaption>{copy.illustrationCaption}</figcaption>
      </figure>

      <div class="profile-favorites-copy">
        <p class="editorial-kicker">{copy.favoritesKicker}</p>
        <h2>{copy.favoritesTitle}</h2>
        <p>{copy.favoritesIntro}</p>

        <div class="profile-favorite-links">
          {
            favoriteLinks.map((item, index) => (
              <a
                class="profile-favorite-card"
                href={item.href}
                target="_blank"
                rel="noopener noreferrer"
                data-reveal
              >
                <small>
                  {String(index + 1).padStart(2, '0')} / {item.kind.toUpperCase()}
                </small>
                <h3>{item.title}</h3>
                <strong>{item.label[locale]}</strong>
                <p>{item.description[locale]}</p>
                <span>{copy.favoriteOpen} ↗</span>
              </a>
            ))
          }
        </div>

        <div class="profile-music-panel" data-reveal>
          <p class="editorial-kicker">MUSIC / PRIVATE MODE</p>
          <h3>{copy.musicTitle}</h3>
          <p>{copy.musicBody}</p>
          <div class="profile-music-palette">
            {copy.musicPalette.map((item) => <span>{item}</span>)}
          </div>
          <DeferredSpotify client:load locale={locale} embedUrl={spotifyEmbedUrl} />
        </div>
      </div>
    </div>
  </section>

  <section class="social-hub section" data-world-zone="signal">
    <div class="section-inner">
      <div class="section-heading" data-reveal>
        <div><p class="section-kicker">LINKS</p><h2>{copy.social}</h2></div>
        <p class="section-intro">{copy.socialIntro}</p>
      </div>
      <div class="social-node-grid">
        {
          socialLinks.map((item, index) => (
            <a
              class={`social-node social-${item.accent}`}
              href={item.href}
              target={item.key === 'email' ? undefined : '_blank'}
              rel={item.key === 'email' ? undefined : 'noopener noreferrer'}
              data-reveal
            >
              <small>LINK / {String(index + 1).padStart(2, '0')}</small>
              <strong>{item.label}</strong>
              <span>{item.description}</span>
              <i aria-hidden="true">↗</i>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="game-clip-archive section" data-world-zone="gamer">
    <div class="section-inner">
      <div class="section-heading" data-reveal>
        <div><p class="section-kicker">GAME CLIPS</p><h2>{copy.clips}</h2></div>
        <p class="section-intro">{copy.clipsIntro}</p>
      </div>
      {
        gameClips.length > 0 ? (
          <div class="clip-grid">
            {gameClips.map((clip, index) => (
              <a
                class="clip-card"
                href={clip.url}
                target="_blank"
                rel="noopener noreferrer"
                data-reveal
              >
                <div class="clip-visual">
                  {clip.thumbnail ? (
                    <img src={clip.thumbnail} alt="" loading="lazy" />
                  ) : (
                    <span>CLIP / {String(index + 1).padStart(2, '0')}</span>
                  )}
                  <b>{clip.duration ?? 'CLIP'}</b>
                </div>
                <small>
                  {clip.platform.toUpperCase()} / {clip.game}
                </small>
                <h3>{clip.title}</h3>
                <div>
                  {clip.tags?.map((tag) => (
                    <span>#{tag}</span>
                  ))}
                </div>
              </a>
            ))}
          </div>
        ) : (
          <div class="clip-empty" data-reveal>
            <span>NO CLIPS</span>
            <p>{copy.clipsEmpty}</p>
          </div>
        )
      }
    </div>
  </section>

  <section class="profile-stack character-capabilities section" data-world-zone="developer">
    <div class="section-inner">
      <div class="section-heading" data-reveal>
        <div><p class="section-kicker">SKILLS</p><h2>{copy.skills}</h2></div>
      </div>
      <div class="stack-groups character-module-grid">
        {
          Object.entries(profile.stack).map(([group, items]) => (
            <article data-reveal>
              <header>
                <h3>{group}</h3>
              </header>
              <ul>
                {items.map((item) => (
                  <li>
                    <span>{item.name}</span>
                    <small data-status={item.status}>{d.profile.statuses[item.status]}</small>
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="timeline character-history section" data-world-zone="night">
    <div class="section-inner">
      <div class="section-heading" data-reveal>
        <div><p class="section-kicker">TIMELINE</p><h2>{copy.timeline}</h2></div>
      </div>
      <div class="timeline-list">
        {
          profile.timeline.map((item, index) => (
            <article data-reveal>
              <span>{item.year}</span>
              <i />
              <p>{d.profile.timelineItems[item.key]}</p>
              <small>{String(index + 1).padStart(2, '0')}</small>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
