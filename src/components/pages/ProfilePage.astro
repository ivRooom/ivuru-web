---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Picture } from 'astro:assets';
import profileVisual from '@/assets/profile-silhouette.webp';
import { profile } from '@/data/profile';
import { siteConfig, type Locale } from '@/data/site-config';
import { getDictionary } from '@/i18n/dictionaries';
const { locale } = Astro.props as { locale: Locale };
const d = getDictionary(locale);
const about = {
  ja: 'Web開発を軸に、ゲーム、クラウド、コミュニティ運営を横断して活動しています。ivRmのオーナー兼運営として、Discord・Minecraft・Webをつなぐ仕組みづくりにも取り組んでいます。',
  en: 'Working across web development, gaming, cloud, and community operations. As the owner and operator of ivRm, I also build connections between Discord, Minecraft, and the web.',
  ko: '웹 개발을 중심으로 게임, 클라우드, 커뮤니티 운영을 넘나들며 활동합니다. ivRm 오너이자 운영자로 Discord, Minecraft, Web을 연결하는 시스템도 만들고 있습니다.',
}[locale];
const statusCopy = {
  ja: { online: 'ONLINE', class: 'Developer / Gamer', base: 'Japan / Digital Room', signal: 'World Gate synchronized' },
  en: { online: 'ONLINE', class: 'Developer / Gamer', base: 'Japan / Digital Room', signal: 'World Gate synchronized' },
  ko: { online: 'ONLINE', class: 'Developer / Gamer', base: 'Japan / Digital Room', signal: 'World Gate synchronized' },
}[locale];
---

<BaseLayout
  title={`${d.profile.title} — ${siteConfig.name} / ${siteConfig.idName}`}
  description={d.profile.intro}
  locale={locale}
  chapter={{ code: '01', title: 'CHARACTER PROFILE', world: 'DEVELOPER WORLD' }}
>
  <header class="page-hero profile-hero character-world page-grid-bg" data-page-intro>
    <div class="page-hero-inner">
      <p class="eyebrow">CHARACTER FILE / 001</p>
      <h1 class="page-title">{d.profile.title}</h1>
      <p>{d.profile.intro}</p>
      <div class="character-scan" aria-hidden="true"><i></i><span>ID / {profile.id.toUpperCase()}</span></div>
    </div>
  </header>

  <section class="profile-character-screen section" data-world-zone="identity">
    <div class="section-inner character-sheet" data-reveal>
      <header class="character-sheet-bar">
        <span>IDENTITY DATABASE</span>
        <span class="character-online"><i></i>{statusCopy.online}</span>
        <span>FILE NO. 001</span>
      </header>

      <div class="character-portrait">
        <div class="character-portrait-frame">
          <Picture
            src={profileVisual}
            widths={[480, 768, 960, 1200]}
            sizes="(max-width: 960px) 90vw, 42vw"
            formats={['avif']}
            fallbackFormat="webp"
            alt={locale === 'ja'
              ? 'デジタルルームのポータルに向かう人物の後ろ姿'
              : locale === 'en'
                ? 'Back-view silhouette facing a portal in a digital room'
                : '디지털 룸의 포털을 바라보는 인물의 뒷모습'}
            loading="eager"
          />
          <div class="character-reticle" aria-hidden="true"><i></i><i></i><i></i></div>
        </div>
        <div class="character-portrait-data">
          <span>CALLSIGN</span><strong>{profile.id}</strong><small>{statusCopy.signal}</small>
        </div>
      </div>

      <div class="character-data">
        <p class="section-kicker">PLAYER / CREATOR PROFILE</p>
        <div class="character-name-line">
          <h2>{profile.name}</h2><span>{profile.id.toUpperCase()}</span>
        </div>
        <p class="character-about">{about}</p>
        <dl class="character-core-stats">
          <div><dt>CLASS</dt><dd>{statusCopy.class}</dd></div>
          <div><dt>BASE</dt><dd>{statusCopy.base}</dd></div>
          <div><dt>ROLE</dt><dd>ivRm Owner / Community Operator</dd></div>
          <div><dt>MODE</dt><dd>BUILD. PLAY. CREATE.</dd></div>
        </dl>
        <div class="role-list character-roles">
          {profile.roles.map((role, index) => <span><small>0{index + 1}</small>{role}</span>)}
        </div>
        <div class="character-interests">
          {profile.interests.map((interest) => <span>{interest}</span>)}
        </div>
      </div>
    </div>
  </section>

  <section class="profile-stack character-capabilities section" data-world-zone="developer">
    <div class="section-inner">
      <div class="section-heading" data-reveal>
        <div><p class="section-kicker">CAPABILITY MODULES</p><h2>{d.profile.stack}</h2></div>
        <p class="section-intro">{
          locale === 'ja'
            ? 'パーセンテージではなく、現在の使用・学習状況で示しています。'
            : locale === 'en'
              ? 'Shown by current practice and learning status—not arbitrary percentages.'
              : '임의의 퍼센트 대신 현재 사용 및 학습 상태로 표시합니다.'
        }</p>
      </div>
      <div class="stack-groups character-module-grid">
        {Object.entries(profile.stack).map(([group, items], groupIndex) => (
          <article data-reveal>
            <header><small>MODULE / {String(groupIndex + 1).padStart(2, '0')}</small><h3>{group}</h3></header>
            <ul>{items.map((item) => <li><span>{item.name}</span><small data-status={item.status}>{d.profile.statuses[item.status]}</small></li>)}</ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="timeline character-history section" data-world-zone="night">
    <div class="section-inner">
      <div class="section-heading" data-reveal>
        <div><p class="section-kicker">CHARACTER LOG / NOW → NEXT</p><h2>{d.profile.timeline}</h2></div>
      </div>
      <div class="timeline-list">
        {profile.timeline.map((item, index) => (
          <article data-reveal><span>{item.year}</span><i /><p>{d.profile.timelineItems[item.key]}</p><small>LOG-{String(index + 1).padStart(2, '0')}</small></article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
