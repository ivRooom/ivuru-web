<script is:inline>
  (() => {
    const cleanupKey = '__ivuruIOSStoryRuntimePreflightDispose';

    const isIOSWebKit = () =>
      /iPad|iPhone|iPod/.test(navigator.userAgent) ||
      (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);

    if (!isIOSWebKit()) return;

    window[cleanupKey]?.();

    const html = document.documentElement;
    const body = document.body;
    html.dataset.storyRuntimeOwner = 'gsap';
    delete html.dataset.storyNativeScrollOwner;
    body?.removeAttribute('data-story-native-scroll-owner');

    let frame = 0;

    const restoreNativeScroll = () => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(() => {
        if (document.body?.classList.contains('site-loading')) return;

        const scrollingElement = document.scrollingElement ?? document.documentElement;
        const secondaryElement = scrollingElement === html ? body : html;

        html.style.removeProperty('overflow-y');
        body?.style.removeProperty('overflow-y');
        html.style.setProperty('scroll-behavior', 'auto', 'important');
        body?.style.setProperty('scroll-behavior', 'auto', 'important');

        scrollingElement.style.setProperty('overflow-y', 'auto', 'important');
        scrollingElement.style.setProperty('scroll-behavior', 'auto', 'important');
        secondaryElement?.style.setProperty('overflow-y', 'visible', 'important');

        html.dataset.storyScrollOwner = scrollingElement === html ? 'document-element' : 'body';
      });
    };

    const onLoaderReleased = () => restoreNativeScroll();

    restoreNativeScroll();
    document.addEventListener('ivuru:loader-released', onLoaderReleased);
    document.addEventListener('astro:page-load', restoreNativeScroll);
    window.addEventListener('pageshow', restoreNativeScroll);

    window[cleanupKey] = () => {
      cancelAnimationFrame(frame);
      document.removeEventListener('ivuru:loader-released', onLoaderReleased);
      document.removeEventListener('astro:page-load', restoreNativeScroll);
      window.removeEventListener('pageshow', restoreNativeScroll);
      delete html.dataset.storyScrollOwner;
      delete window[cleanupKey];
    };
  })();
</script>
