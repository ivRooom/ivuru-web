<script is:inline>
  (() => {
    const cleanupKey = '__ivuruIOSStoryDirectorRecoveryDispose';
    const recoveryDelay = 5_000;
    const recoveryHeartbeatMs = 120;
    const chapters = ['01', '02', '03'];
    const contentSelector =
      '[data-story-copy], [data-story-visual], [data-story-pop], [data-story-depth]';

    const isIOSWebKit = () =>
      /iPad|iPhone|iPod/.test(navigator.userAgent) ||
      (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);

    const setup = () => {
      window[cleanupKey]?.();

      const root = document.querySelector('[data-anime-scroll-story]');
      if (!(root instanceof HTMLElement) || !isIOSWebKit()) return;

      const scenes = Array.from(root.querySelectorAll('[data-anime-story-scene]')).filter(
        (scene) => scene instanceof HTMLElement,
      );
      if (scenes.length !== chapters.length) return;

      const dots = Array.from(root.querySelectorAll('[data-story-progress-dot]')).filter(
        (dot) => dot instanceof HTMLElement,
      );
      const readout = root.querySelector('[data-story-chapter-readout]');
      const progressLine = root.querySelector('[data-story-progress-line]');
      let disposed = false;
      let recoveryActive = false;
      let start = 0;
      let end = 1;
      let activeIndex = -1;
      let timer = 0;
      let heartbeat = 0;
      let frame = 0;
      let rootObserver;
      let visibilityObserver;

      root.dataset.storyPlatform = 'ios-webkit';

      const realDirectorIsReady = () =>
        root.dataset.storyDirector === 'ready' &&
        root.dataset.storyRuntime === 'ready' &&
        root.dataset.storyMobileStability === 'ready' &&
        root.dataset.storyTransitionEngine === 'world-forge' &&
        root.dataset.storySnapState === 'ready';

      const rootNearViewport = () => {
        const rect = root.getBoundingClientRect();
        const viewportHeight = window.visualViewport?.height ?? window.innerHeight;
        return rect.bottom >= -viewportHeight * 0.25 && rect.top <= viewportHeight * 1.25;
      };

      const setData = (key, value) => {
        if (root.dataset[key] !== value) root.dataset[key] = value;
      };

      const setStyle = (element, property, value) => {
        if (element.style.getPropertyValue(property) !== value) {
          element.style.setProperty(property, value);
        }
      };

      const cancelActivation = () => {
        window.clearTimeout(timer);
        timer = 0;
      };

      const repairRootState = () => {
        if (disposed || !recoveryActive || !root.isConnected) return;
        setData('storyDirector', 'ready');
        setData('storyRuntime', 'ready');
        setData('storyProgressAuthority', 'ready');
        setData('storyMobileStability', 'ready');
        setData('storyMode', 'motion');
        setData('storyMask', 'active');
        setData('storyPerformance', 'ios-inline-recovery');
        setData('storyTransitionEngine', 'ios-inline-recovery');
        setData('storySnap', 'disabled-mobile');
        setData('storySnapState', 'ready');
        setData('storyNativeRecovery', 'true');
        delete root.dataset.storyRuntimeReason;
        delete root.dataset.storyMobileRecovery;
        delete root.dataset.storyMobileTerminalFallback;
      };

      const releaseRecoveryStyles = () => {
        delete root.dataset.storyNativeRecovery;
        delete document.documentElement.dataset.storyNativeScrollOwner;
        delete document.body.dataset.storyNativeScrollOwner;
        root.style.removeProperty('overflow-x');
        root.style.removeProperty('min-height');
        root.style.removeProperty('--story-native-runtime-height');
        root.style.removeProperty('--story-native-scroll-distance');
        scenes.forEach((scene) => {
          scene.style.removeProperty('opacity');
          scene.style.removeProperty('visibility');
          scene.style.removeProperty('pointer-events');
          scene.style.removeProperty('transform');
          scene.style.removeProperty('transition');
        });
      };

      const stopRecovery = () => {
        if (!recoveryActive) return;
        recoveryActive = false;
        window.clearInterval(heartbeat);
        heartbeat = 0;
        releaseRecoveryStyles();
      };

      const currentProgress = () =>
        Math.max(0, Math.min(1, (window.scrollY - start) / Math.max(1, end - start)));

      const updateRange = () => {
        const viewportHeight = Math.max(1, window.visualViewport?.height ?? window.innerHeight);
        const scrollDistance = Math.max(1, Math.round(viewportHeight * 5.7));
        const runtimeHeight = viewportHeight + scrollDistance;
        setStyle(root, '--story-native-runtime-height', `${runtimeHeight}px`);
        setStyle(root, '--story-native-scroll-distance', `${scrollDistance}px`);
        setStyle(root, 'min-height', `${runtimeHeight}px`);

        const rootTop = root.getBoundingClientRect().top + window.scrollY;
        start = Math.max(0, rootTop);
        end = start + scrollDistance;
        setData('storyScrollStart', String(Math.round(start)));
        setData('storyScrollEnd', String(Math.round(end)));
      };

      const sync = () => {
        frame = 0;
        if (disposed || !root.isConnected) return;

        if (realDirectorIsReady()) {
          cancelActivation();
          stopRecovery();
          return;
        }
        if (!recoveryActive) return;

        repairRootState();
        const progress = currentProgress();
        const nextIndex = progress < 0.34 ? 0 : progress < 0.67 ? 1 : 2;
        const chapter = chapters[nextIndex];
        const chapterChanged = nextIndex !== activeIndex;
        activeIndex = nextIndex;

        setData('storyChapter', chapter);
        setData('storyAuthorityChapter', chapter);
        setData('storyAuthorityProgress', progress.toFixed(4));
        setStyle(root, '--story-authority-progress', progress.toFixed(4));
        setStyle(root, 'overflow-x', 'clip');

        const rect = root.getBoundingClientRect();
        setData(
          'storyInView',
          rect.bottom >= 0 && rect.top <= (window.visualViewport?.height ?? window.innerHeight)
            ? 'true'
            : 'false',
        );

        scenes.forEach((scene, index) => {
          const active = index === nextIndex;
          scene.dataset.active = active ? 'true' : 'false';
          scene.setAttribute('aria-hidden', active ? 'false' : 'true');
          scene.toggleAttribute('inert', !active);
          setStyle(scene, 'opacity', active ? '1' : '0');
          setStyle(scene, 'visibility', active ? 'visible' : 'hidden');
          setStyle(scene, 'pointer-events', active ? 'auto' : 'none');
          setStyle(scene, 'transform', active ? 'translate3d(0, 0, 0)' : 'translate3d(0, 20px, 0)');
          setStyle(scene, 'transition', 'opacity 220ms ease, transform 260ms ease');

          if (active) {
            scene.querySelectorAll(contentSelector).forEach((node) => {
              if (!(node instanceof HTMLElement)) return;
              node.style.removeProperty('opacity');
              node.style.removeProperty('visibility');
            });
          }
        });

        dots.forEach((dot, index) => {
          dot.dataset.active = index === nextIndex ? 'true' : 'false';
        });
        if (readout instanceof HTMLElement) readout.textContent = `${chapter} / 03`;
        if (progressLine instanceof HTMLElement) {
          setStyle(progressLine, 'transform', `scaleX(${progress})`);
        }
        document.body.dataset.animeScene = scenes[nextIndex]?.dataset.storyScene ?? 'ice';

        if (chapterChanged) {
          window.dispatchEvent(
            new CustomEvent('ivuru:story-chapter-change', {
              detail: {
                chapter,
                index: nextIndex,
                source: 'ios-inline-recovery',
              },
            }),
          );
        }
      };

      const scheduleSync = () => {
        if (frame) return;
        frame = requestAnimationFrame(sync);
      };

      const activate = () => {
        timer = 0;
        if (disposed || recoveryActive || realDirectorIsReady() || !rootNearViewport()) return;

        recoveryActive = true;
        root.dataset.storyNativeRecovery = 'true';
        document.documentElement.dataset.storyNativeScrollOwner = 'true';
        document.body.dataset.storyNativeScrollOwner = 'true';
        updateRange();
        repairRootState();
        sync();
        heartbeat = window.setInterval(scheduleSync, recoveryHeartbeatMs);
      };

      const scheduleActivation = () => {
        if (disposed || recoveryActive || timer || realDirectorIsReady() || !rootNearViewport()) {
          return;
        }
        timer = window.setTimeout(activate, recoveryDelay);
      };

      const onScroll = () => {
        if (realDirectorIsReady()) {
          cancelActivation();
          stopRecovery();
          return;
        }
        scheduleActivation();
        scheduleSync();
      };

      const onViewportChange = () => {
        if (realDirectorIsReady()) {
          cancelActivation();
          stopRecovery();
          return;
        }
        scheduleActivation();
        if (!recoveryActive) return;
        const progress = currentProgress();
        updateRange();
        window.scrollTo(0, start + (end - start) * progress);
        repairRootState();
        scheduleSync();
      };

      rootObserver = new MutationObserver(() => {
        if (realDirectorIsReady()) {
          cancelActivation();
          stopRecovery();
          return;
        }
        if (recoveryActive) scheduleSync();
      });
      rootObserver.observe(root, {
        attributes: true,
        attributeFilter: [
          'data-story-runtime',
          'data-story-runtime-reason',
          'data-story-director',
          'data-story-mode',
          'data-story-transition-engine',
          'data-story-mobile-stability',
        ],
      });

      if ('IntersectionObserver' in window) {
        visibilityObserver = new IntersectionObserver(
          ([entry]) => {
            if (entry?.isIntersecting) scheduleActivation();
            else if (!recoveryActive) cancelActivation();
          },
          { root: null, rootMargin: '125% 0px 125% 0px', threshold: 0 },
        );
        visibilityObserver.observe(root);
      } else {
        scheduleActivation();
      }

      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onViewportChange, { passive: true });
      window.addEventListener('orientationchange', onViewportChange, { passive: true });
      window.addEventListener('pageshow', onViewportChange);
      window.visualViewport?.addEventListener('resize', onViewportChange, { passive: true });

      window[cleanupKey] = () => {
        disposed = true;
        cancelActivation();
        window.clearInterval(heartbeat);
        cancelAnimationFrame(frame);
        rootObserver?.disconnect();
        visibilityObserver?.disconnect();
        window.removeEventListener('scroll', onScroll);
        window.removeEventListener('resize', onViewportChange);
        window.removeEventListener('orientationchange', onViewportChange);
        window.removeEventListener('pageshow', onViewportChange);
        window.visualViewport?.removeEventListener('resize', onViewportChange);
        if (recoveryActive) releaseRecoveryStyles();
        delete window[cleanupKey];
      };
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setup, { once: true });
    } else {
      queueMicrotask(setup);
    }
    document.addEventListener('astro:page-load', setup);
  })();
</script>
