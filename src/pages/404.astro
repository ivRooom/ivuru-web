---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { localePath, type Locale } from '@/data/site-config';
import { getDictionary } from '@/i18n/dictionaries';
const locale: Locale = Astro.url.pathname.startsWith('/en')
  ? 'en'
  : Astro.url.pathname.startsWith('/ko')
    ? 'ko'
    : 'ja';
const d = getDictionary(locale);
const copy = {
  ja: {
    signal: 'ワールド接続が失われました',
    route: '指定されたルートは存在しないか、別の世界線へ移動しました。',
    works: '作品を見る',
    status: 'ROUTE SIGNAL / LOST',
  },
  en: {
    signal: 'The world connection was lost',
    route: 'This route does not exist, or it has moved to another world line.',
    works: 'View works',
    status: 'ROUTE SIGNAL / LOST',
  },
  ko: {
    signal: '월드 연결이 끊어졌습니다',
    route: '요청한 경로가 없거나 다른 월드 라인으로 이동했습니다.',
    works: '작품 보기',
    status: 'ROUTE SIGNAL / LOST',
  },
}[locale];
---

<BaseLayout
  title={`404 — ${d.notFound.title}`}
  description={d.notFound.body}
  locale={locale}
  noindex
>
  <section class="error-world" aria-labelledby="error-title">
    <div class="error-world-sky" aria-hidden="true">
      <i class="error-star star-a"></i><i class="error-star star-b"></i><i
        class="error-star star-c"></i><i class="error-star star-d"></i>
      <div class="error-scanline"></div>
      <div class="error-shard shard-a"></div><div class="error-shard shard-b"></div><div
        class="error-shard shard-c"></div>
    </div>

    <div class="error-portal" aria-hidden="true">
      <i></i><i></i><i></i><span></span>
    </div>

    <div class="error-content">
      <p class="error-route-signal"><span></span>{copy.status}</p>
      <div class="error-code" aria-label="404">
        <span data-ghost="4">4</span><span class="error-zero" data-ghost="0">0<i></i></span><span
          data-ghost="4">4</span
        >
      </div>
      <p class="error-world-id">WORLD NODE / UNKNOWN · ID / IVURU</p>
      <h1 id="error-title">{copy.signal}</h1>
      <p class="error-description">{copy.route}</p>
      <div class="error-actions">
        <a class="primary-button" href={localePath(locale, '/')}>{d.notFound.action}</a>
        <a class="secondary-button" href={localePath(locale, '/works')}>{copy.works}</a>
      </div>
      <div class="error-system-log" aria-hidden="true">
        <span>GATE STATUS: OFFLINE</span><span>RETRY PATH: AVAILABLE</span><span
          >MEMORY FRAGMENT: 04</span
        >
      </div>
    </div>
  </section>
</BaseLayout>