---
import { getCollection } from 'astro:content';
import BlogDetailPage from '@/components/pages/BlogDetailPage.astro';
export async function getStaticPaths() {
  const all = await getCollection('blog', ({ data }) => !data.draft && data.locale === 'ko');
  return all.map((post) => ({
    params: { slug: post.id.replace(/^ko\//, '').replace(/\.(md|mdx)$/, '') },
    props: { post, allPosts: all },
  }));
}
const { post, allPosts } = Astro.props;
---

<BlogDetailPage locale="ko" post={post} allPosts={allPosts} />
