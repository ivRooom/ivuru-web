---
import { ClientRouter } from 'astro:transitions';
import { localePath, siteConfig, type Locale } from '@/data/site-config';
import '@/styles/official-site.css';

type Chapter = { code: string; title: string; world: string };
type Props = {
  title: string;
  description: string;
  locale?: Locale;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  chapter?: Chapter;
};

const {
  title,
  description,
  locale = 'ja',
  image = siteConfig.defaultOgImage,
  type = 'website',
  noindex = false,
} = Astro.props;
const resolvedTitle = title.replaceAll('ivuruGG', `${siteConfig.name} / ${siteConfig.idName}`);
const canonical = new URL(Astro.url.pathname, siteConfig.siteUrl);
const normalized = Astro.url.pathname.replace(/^\/(en|ko)(?=\/|$)/, '') || '/';
const ogImage = new URL(image, siteConfig.siteUrl);
const navigation = {
  ja: [
    ['ホーム', '/'], ['プロフィール', '/profile'], ['制作物', '/works'], ['ニュース', '/news'], ['ブログ', '/blog'],
  ],
  en: [
    ['Home', '/'], ['Profile', '/profile'], ['Works', '/works'], ['News', '/news'], ['Blog', '/blog'],
  ],
  ko: [
    ['홈', '/'], ['프로필', '/profile'], ['프로젝트', '/works'], ['뉴스', '/news'], ['블로그', '/blog'],
  ],
} as const;
const footerCopy = {
  ja: '開発、ゲーム、コミュニティをつなぐ、いゔる。の個人公式サイト。',
  en: 'The personal official site of ivuru, connecting development, games, and community.',
  ko: '개발, 게임, 커뮤니티를 연결하는 ivuru의 개인 공식 사이트.',
};
---

<!doctype html>
<html lang={locale} data-theme="light" data-theme-mode="system" data-official-site>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f7f8fb" />
    <title>{resolvedTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {siteConfig.locales.map((lang) => <link rel="alternate" hreflang={lang === 'ja' ? 'ja-JP' : lang === 'en' ? 'en-US' : 'ko-KR'} href={new URL(localePath(lang, normalized), siteConfig.siteUrl)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(localePath('ja', normalized), siteConfig.siteUrl)} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={resolvedTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={siteConfig.xHandle} />
    <meta name="twitter:title" content={resolvedTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title={`${siteConfig.name} Blog`} href="/rss.xml" />
    <ClientRouter fallback="animate" />
    <script is:inline>
      (() => {
        const stored = localStorage.getItem('ivuru-theme') || 'system';
        const resolved = stored === 'system' ? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light') : stored;
        document.documentElement.dataset.theme = resolved;
        document.documentElement.dataset.themeMode = stored;
      })();
    </script>
  </head>
  <body>
    <a class="official-skip-link" href="#main-content">Skip to content</a>
    <header class="official-header">
      <div class="official-shell official-header__inner">
        <a class="official-brand" href={localePath(locale, '/')} aria-label={`${siteConfig.name} home`}>
          <span class="official-brand__mark" aria-hidden="true">i</span>
          <span><strong>{siteConfig.name}</strong><small>{siteConfig.idName}</small></span>
        </a>
        <nav class="official-nav" aria-label="Primary navigation">
          {navigation[locale].map(([label, href]) => <a class={normalized === href ? 'is-current' : ''} href={localePath(locale, href)}>{label}</a>)}
        </nav>
        <div class="official-header__actions">
          <label class="official-theme-control"><span class="sr-only">Theme</span><select data-theme-select aria-label="Theme"><option value="system">Auto</option><option value="light">Light</option><option value="dark">Dark</option></select></label>
          <a class="official-button official-button--small" href={localePath(locale, '/contact')}>Contact</a>
        </div>
      </div>
    </header>
    <main id="main-content" tabindex="-1" transition:name="official-page"><slot /></main>
    <footer class="official-footer">
      <div class="official-shell official-footer__inner">
        <div><a class="official-brand official-brand--footer" href={localePath(locale, '/')}><span class="official-brand__mark" aria-hidden="true">i</span><span><strong>{siteConfig.name}</strong><small>{siteConfig.idName}</small></span></a><p>{footerCopy[locale]}</p></div>
        <div class="official-footer__links"><a href={siteConfig.githubUrl} target="_blank" rel="noreferrer">GitHub</a><a href={siteConfig.xUrl} target="_blank" rel="noreferrer">X</a><a href={siteConfig.ivrmUrl} target="_blank" rel="noreferrer">ivRm</a></div>
        <p class="official-footer__copyright">© {new Date().getFullYear()} ivuru.</p>
      </div>
    </footer>
    <script is:inline>
      (() => {
        const bindTheme = () => {
          const select = document.querySelector('[data-theme-select]');
          if (!(select instanceof HTMLSelectElement) || select.dataset.bound === 'true') return;
          select.dataset.bound = 'true';
          select.value = document.documentElement.dataset.themeMode || 'system';
          select.addEventListener('change', () => {
            const mode = select.value;
            const resolved = mode === 'system' ? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light') : mode;
            localStorage.setItem('ivuru-theme', mode);
            document.documentElement.dataset.themeMode = mode;
            document.documentElement.dataset.theme = resolved;
          });
        };
        bindTheme();
        document.addEventListener('astro:page-load', bindTheme);
      })();
    </script>
  </body>
</html>
