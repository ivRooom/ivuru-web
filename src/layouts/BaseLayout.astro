---
import Header from '@/components/common/Header.astro';
import Footer from '@/components/common/Footer.astro';
import IntroLoader from '@/components/common/IntroLoader';
import ChapterCut from '@/components/common/ChapterCut';
import WorldState from '@/components/common/WorldState';
import ScrollProgress from '@/components/common/ScrollProgress';
import ScrollEffects from '@/components/effects/ScrollEffects';
import AnalyticsBridge from '@/components/common/AnalyticsBridge.astro';
import { siteConfig, localePath, type Locale } from '@/data/site-config';
import { ClientRouter } from 'astro:transitions';
import '@/styles/global.css';
import '@/styles/experience.css';
import '@/styles/navigation-fix.css';
import '@/styles/world-system.css';
import '@/styles/profile-hub.css';
import '@/styles/contact-terminal.css';
import '@/styles/layout-fixes.css';
import '@/styles/activity-command-center.css';
import '@/styles/anime-experience.css';
import '@/styles/blue-media-renewal.css';
import '@/styles/blue-media-motion.css';
import '@/styles/cinematic-motion.css';

type Chapter = {
  code: string;
  title: string;
  world: string;
};

type Props = {
  title: string;
  description: string;
  locale?: Locale;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  chapter?: Chapter;
};
const {
  title,
  description,
  locale = 'ja',
  image = siteConfig.defaultOgImage,
  type = 'website',
  noindex = false,
  chapter = { code: '00', title: 'WORLD GATE', world: 'NEXUS' },
} = Astro.props;
const resolvedTitle = title.replaceAll('ivuruGG', `${siteConfig.name} / ${siteConfig.idName}`);
const canonical = new URL(Astro.url.pathname, siteConfig.siteUrl);
const normalized = Astro.url.pathname.replace(/^\/(en|ko)(?=\/|$)/, '') || '/';
const ogImage = new URL(image, siteConfig.siteUrl);
const fallbackOgImage = new URL(siteConfig.fallbackOgImage, siteConfig.siteUrl);
const ogImageType = image.endsWith('.svg')
  ? 'image/svg+xml'
  : image.endsWith('.webp')
    ? 'image/webp'
    : 'image/png';
const twitterImage = image.endsWith('.svg') ? fallbackOgImage : ogImage;
const sameAs = [
  siteConfig.xUrl,
  siteConfig.instagramUrl,
  siteConfig.tiktokUrl,
  siteConfig.twitchUrl,
  siteConfig.youtubeUrl,
].filter(Boolean);
const pageWorld = chapter.world
  .toLowerCase()
  .replaceAll(/[^a-z0-9]+/g, '-')
  .replace(/^-|-$/g, '');
---

<!doctype html>
<html
  lang={locale}
  data-theme="dark"
  data-theme-mode="system"
  data-chapter={chapter.code}
  data-world={pageWorld}
  data-world-time="dawn"
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#08111f" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={resolvedTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content={ogImageType} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:locale" content={locale === 'ja' ? 'ja_JP' : locale === 'ko' ? 'ko_KR' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={resolvedTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={twitterImage} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="alternate" hreflang="ja" href={new URL(localePath('ja', normalized), siteConfig.siteUrl)} />
    <link rel="alternate" hreflang="en" href={new URL(localePath('en', normalized), siteConfig.siteUrl)} />
    <link rel="alternate" hreflang="ko" href={new URL(localePath('ko', normalized), siteConfig.siteUrl)} />
    <link rel="alternate" hreflang="x-default" href={new URL(localePath('ja', normalized), siteConfig.siteUrl)} />
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: siteConfig.name,
        alternateName: siteConfig.idName,
        url: siteConfig.siteUrl,
        sameAs,
      })}
    />
    <title>{resolvedTitle}</title>
    <ClientRouter />
  </head>
  <body class="site-shell site-loading">
    <IntroLoader client:load locale={locale} />
    <ChapterCut client:load chapter={chapter} locale={locale} />
    <WorldState client:load />
    <ScrollProgress client:load />
    <ScrollEffects client:load />
    <AnalyticsBridge />
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header locale={locale} currentPath={Astro.url.pathname} />
    <main id="main-content">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
