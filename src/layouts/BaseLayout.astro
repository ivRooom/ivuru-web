---
import Header from '@/components/common/Header.astro';
import Footer from '@/components/common/Footer.astro';
import IntroLoader from '@/components/common/IntroLoader';
import ChapterCut from '@/components/common/ChapterCut';
import WorldState from '@/components/common/WorldState';
import ScrollProgress from '@/components/common/ScrollProgress';
import ScrollEffects from '@/components/effects/ScrollEffects';
import AnalyticsBridge from '@/components/common/AnalyticsBridge.astro';
import { siteConfig, localePath, type Locale } from '@/data/site-config';
import { ClientRouter } from 'astro:transitions';
import '@/styles/global.css';
import '@/styles/experience.css';
import '@/styles/navigation-fix.css';
import '@/styles/world-system.css';
import '@/styles/profile-hub.css';
import '@/styles/contact-terminal.css';
import '@/styles/layout-fixes.css';
import '@/styles/activity-command-center.css';
import '@/styles/anime-experience.css';
import '@/styles/blue-media-renewal.css';
import '@/styles/blue-media-motion.css';

type Chapter = {
  code: string;
  title: string;
  world: string;
};

type Props = {
  title: string;
  description: string;
  locale?: Locale;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  chapter?: Chapter;
};
const {
  title,
  description,
  locale = 'ja',
  image = siteConfig.defaultOgImage,
  type = 'website',
  noindex = false,
  chapter = { code: '00', title: 'WORLD GATE', world: 'NEXUS' },
} = Astro.props;
const resolvedTitle = title.replaceAll('ivuruGG', `${siteConfig.name} / ${siteConfig.idName}`);
const canonical = new URL(Astro.url.pathname, siteConfig.siteUrl);
const normalized = Astro.url.pathname.replace(/^\/(en|ko)(?=\/|$)/, '') || '/';
const ogImage = new URL(image, siteConfig.siteUrl);
const fallbackOgImage = new URL(siteConfig.fallbackOgImage, siteConfig.siteUrl);
const ogImageType = image.endsWith('.svg')
  ? 'image/svg+xml'
  : image.endsWith('.webp')
    ? 'image/webp'
    : 'image/png';
const twitterImage = image.endsWith('.svg') ? fallbackOgImage : ogImage;
const sameAs = [
  siteConfig.xUrl,
  siteConfig.instagramUrl,
  siteConfig.tiktokUrl,
  siteConfig.twitchUrl,
  siteConfig.youtubeUrl,
].filter(Boolean);
const pageWorld = chapter.world
  .toLowerCase()
  .replaceAll(/[^a-z0-9]+/g, '-')
  .replace(/^-|-$/g, '');
---

<!doctype html>
<html
  lang={locale}
  data-theme="dark"
  data-theme-mode="system"
  data-chapter={chapter.code}
  data-world={pageWorld}
  data-world-time="dawn"
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#061a39" />
    <title>{resolvedTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      siteConfig.locales.map((lang) => (
        <link
          rel="alternate"
          hreflang={lang === 'ja' ? 'ja-JP' : lang === 'en' ? 'en-US' : 'ko-KR'}
          href={new URL(localePath(lang, normalized), siteConfig.siteUrl)}
        />
      ))
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(localePath('ja', normalized), siteConfig.siteUrl)}
    />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={resolvedTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content={ogImageType} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content={`${siteConfig.name} / ${siteConfig.idName} — Developer World × Gamer World`}
    />
    {
      ogImage.href !== fallbackOgImage.href && (
        <>
          <meta property="og:image" content={fallbackOgImage} />
          <meta property="og:image:secure_url" content={fallbackOgImage} />
          <meta property="og:image:type" content="image/png" />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta
            property="og:image:alt"
            content={`${siteConfig.name} / ${siteConfig.idName} official site`}
          />
        </>
      )
    }
    <meta property="og:site_name" content={`${siteConfig.name} / ${siteConfig.idName}`} />
    <meta
      property="og:locale"
      content={locale === 'ja' ? 'ja_JP' : locale === 'en' ? 'en_US' : 'ko_KR'}
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={siteConfig.xHandle} />
    <meta name="twitter:title" content={resolvedTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={twitterImage} />
    <meta
      name="twitter:image:alt"
      content={`${siteConfig.name} / ${siteConfig.idName} official world portal`}
    />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/site.webmanifest" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${siteConfig.name} Blog`}
      href="/rss.xml"
    />
    <script is:inline>
      (() => {
        const stored = localStorage.getItem('ivuru-theme') || 'system';
        const resolved =
          stored === 'system'
            ? matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light'
            : stored;
        document.documentElement.dataset.theme = resolved;
        document.documentElement.dataset.themeMode = stored;
      })();
    </script>
    <script is:inline define:vars={{ currentLocale: locale }}>
      (() => {
        if (localStorage.getItem('ivuru-locale')) return;
        if (currentLocale !== 'ja') {
          localStorage.setItem('ivuru-locale', currentLocale);
          return;
        }
        const detected = navigator.language.toLowerCase().startsWith('ko')
          ? 'ko'
          : navigator.language.toLowerCase().startsWith('en')
            ? 'en'
            : 'ja';
        localStorage.setItem('ivuru-locale', detected);
        if (detected !== 'ja')
          location.replace(`/${detected}${location.pathname === '/' ? '' : location.pathname}`);
      })();
    </script>
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Person',
        name: siteConfig.name,
        alternateName: siteConfig.idName,
        url: siteConfig.siteUrl,
        sameAs,
        image: siteConfig.profileImageUrl,
        email: `mailto:${siteConfig.email}`,
        jobTitle: 'Developer / Gamer',
        description,
      })}
    />
    <ClientRouter />
  </head>
  <body data-page-world={pageWorld} data-anime-scene="ice">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <IntroLoader locale={locale} client:load transition:persist="intro-loader" />
    <script is:inline>
      (() => {
        const delay = matchMedia('(prefers-reduced-motion: reduce)').matches ? 350 : 2400;
        window.setTimeout(() => {
          const loader = document.querySelector('.world-loader');
          if (!(loader instanceof HTMLElement)) return;
          document.documentElement.dataset.loaderReleased = 'true';
          loader.dataset.failsafeHidden = 'true';
          document.body.classList.remove('site-loading');
        }, delay);
      })();
    </script>
    <ChapterCut client:load transition:persist="chapter-cut" />
    <WorldState client:load transition:persist="world-state" />
    <AnalyticsBridge />
    <div class="world-atmosphere" aria-hidden="true"><i></i><i></i><i></i></div>
    <ScrollProgress client:load />
    <ScrollEffects client:idle />
    <Header locale={locale} />
    <main id="main-content"><slot /></main>
    <Footer locale={locale} />
    <div class="noise" aria-hidden="true"></div>
  </body>
</html>
