{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ivrm-ivurugg",
  "main": "./src/worker-entry.ts",
  "compatibility_date": "2026-07-13",
  "keep_vars": true,

  "vars": {
    "CONTACT_TO_EMAIL": "contact.ivuru@ivrm.jp",
    "CONTACT_FROM_EMAIL": "ivuru Contact <info.ivuru@ivrm.jp>",
    "CONTACT_RECEIPT_FROM_EMAIL": "ivuru Contact <info.ivuru@ivrm.jp>",
    "CONTACT_RECEIPT_BCC_EMAIL": "ivuruGG.info@gmail.com",
    "CONTACT_RETENTION_DAYS": "90",
    "ALLOWED_ORIGINS": "https://ivurugg.ivrm.jp,https://ivuru.ivrm.jp",
    "X_PROFILE_USERNAME": "ivuruGG",
    "X_PROFILE_CACHE_TTL_SECONDS": "21600"
  },

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  "triggers": {
    "crons": ["17 18 * * *"]
  },

  "d1_databases": [
    {
      "binding": "CONTACT_DB",
      "database_name": "ivuru-contact-production",
      "database_id": "985dee82-e9bd-4e7d-b18c-1fb8f4777968",
      "migrations_dir": "migrations"
    }
  ],

  "queues": {
    "producers": [
      {
        "binding": "CONTACT_DELIVERY_QUEUE",
        "queue": "ivuru-contact-delivery"
      }
    ],
    "consumers": [
      {
        "queue": "ivuru-contact-delivery",
        "max_batch_size": 5,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "ivuru-contact-delivery-dlq",
        "retry_delay": 60
      }
    ]
  },

  "ratelimits": [
    {
      "name": "CONTACT_RATE_LIMITER",
      "namespace_id": "1661",
      "simple": {
        "limit": 3,
        "period": 60
      }
    }
  ],

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
