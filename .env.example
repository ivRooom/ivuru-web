# Cloudflare Workers Buildsの本番URL。canonical / OGP / JSON-LD / sitemap / RSSで使用します。
SITE_URL=https://ivurugg.ivrm.jp

# Cloudflare Web Analyticsなどを有効化した後に設定します。
PUBLIC_ANALYTICS_ID=

# Contact実装までは空のままにします。
PUBLIC_CONTACT_URL=

# InstagramプロフィールURL。未設定時はInstagramカードの外部リンクを表示しません。
PUBLIC_INSTAGRAM_URL=

# 表示したいInstagram投稿URLをカンマ区切りで最大3件まで指定します。
# 例: https://www.instagram.com/p/POST_ID_1/,https://www.instagram.com/p/POST_ID_2/
PUBLIC_INSTAGRAM_POST_URLS=
